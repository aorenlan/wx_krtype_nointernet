<view class="tab-bar {{dark ? 'dark' : ''}} {{hidden ? 'is-hidden' : ''}}">
  <view class="tab-bar-shell">
    <view
      wx:for="{{list}}"
      wx:key="index"
      class="tab-bar-item {{selected === index ? 'active' : ''}}"
      data-path="{{item.pagePath}}"
      data-index="{{index}}"
      bindtap="switchTab"
      hover-class="none"
    >
      <view class="tab-content">
        <image class="tab-icon" src="{{selected === index ? item.selectedIconPath : item.iconPath}}" mode="aspectFit"></image>
        <view class="tab-label">{{item.shortText || item.text}}</view>
      </view>
    </view>
  </view>
</view>
