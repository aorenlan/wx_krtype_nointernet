}

.icon-text {
  color: rgba(255, 255, 255, 0.9);
  font-size: 36rpx;
  font-weight: 900;
}

.keyboard-container.light .icon-text {
  color: #53635e;
}

.space-row {
  margin-top: 14rpx;
  padding: 0 42rpx;
}

.space-btn {
  height: 90rpx;
  border-radius: 999rpx;
  background: rgba(38, 39, 45, 0.78);
  color: rgba(255, 255, 255, 0.72);
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  box-shadow:
    0 10rpx 20rpx rgba(0, 0, 0, 0.14),
