}

.keyboard-container.legacy .active-target .key-main,
.keyboard-container.legacy .active-target .key-sub,
.keyboard-container.legacy .active-target.text-white {
  color: #ffffff !important;
}

.key-main {
  color: rgba(255, 255, 255, 0.94);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.keyboard-container.light .key-main {
  color: #202126;
}

.key-sub {
  right: 9rpx;
  bottom: 7rpx;
  color: currentColor;
  font-size: 19rpx;
  font-weight: 800;
  opacity: 0.42;
}

.special-key {
  height: 96rpx;
  border-radius: 18rpx;
