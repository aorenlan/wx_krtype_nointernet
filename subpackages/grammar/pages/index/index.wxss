.page {
  display: flex;
  height: 100vh;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  background: #f8f8f9;
  color: #202126;
}

.header {
  position: relative;
  z-index: 10;
  flex: none;
  padding: 0 40rpx 20rpx;
  background: #f8f8f9;
}

.header-row {
  display: flex;
  align-items: center;
}

.back-btn-simple {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  margin-left: -14rpx;
  border-radius: 999rpx;
  background: #17181d;
  box-shadow: 0 10rpx 22rpx rgba(24, 25, 30, 0.14);
}

.back-btn-simple:active {
  opacity: 0.9;
  transform: scale(0.96);
}

.back-btn-simple .back-icon {
  padding-bottom: 4rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1;
}

.header-title {
  overflow: hidden;
  color: #202126;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-sub {
  display: block;
  margin-top: 8rpx;
  padding-left: 66rpx;
  color: #8b8d96;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.25;
}

.switch-course-btn {
  display: flex;
  min-height: 58rpx;
  align-items: center;
  justify-content: center;
  margin-left: auto;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background:
    radial-gradient(circle at 100% 0%, rgba(246, 179, 90, 0.16), transparent 36%),
    rgba(255, 255, 255, 0.92);
  box-shadow:
    0 12rpx 30rpx rgba(24, 25, 30, 0.08),
    inset 0 0 0 1rpx rgba(24, 25, 30, 0.04);
  color: #202126;
  font-size: 22rpx;
  font-weight: 900;
}

.switch-course-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.content {
  position: relative;
  display: flex;
  height: 0;
  flex: 1;
  background: #f8f8f9;
}

.mask {
  position: absolute;
  inset: 0;
  z-index: 90;
  background: rgba(23, 24, 29, 0.22);
  opacity: 1;
  visibility: visible;
  backdrop-filter: blur(3px);
  pointer-events: auto;
  transition: opacity 0.2s ease, visibility 0.2s ease;
}

.mask-hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.collapse-trigger-fixed {
  position: absolute;
  top: 18rpx;
  right: 34rpx;
  z-index: 80;
  display: flex;
  min-width: 124rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 999rpx;
  background: #17181d;
  color: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(24, 25, 30, 0.16);
}

.collapse-trigger-fixed:active {
  opacity: 0.92;
  transform: scale(0.97);
}

.menu-icon {
  display: flex;
  width: 28rpx;
  height: 22rpx;
  flex-direction: column;
  justify-content: space-between;
}

.menu-icon .line {
  width: 100%;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.catalog-trigger-text {
  color: currentColor;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
}

.sidebar {
  position: absolute;
  top: auto;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  z-index: 100;
  height: 76%;
  overflow: hidden;
  border-radius: 42rpx;
  background:
    radial-gradient(circle at 100% 0%, rgba(246, 179, 90, 0.1), transparent 34%),
    rgba(255, 255, 255, 0.98);
  box-shadow:
    0 28rpx 70rpx rgba(24, 25, 30, 0.15),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  transition: opacity 0.22s ease, transform 0.3s cubic-bezier(0.18, 0.86, 0.25, 1);
  transform: translateY(0);
}

.sidebar-inner {
  display: flex;
  width: 100%;
  height: 100%;
  flex-direction: column;
  background: transparent;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  flex: 0 0 8rpx;
  margin: 18rpx auto 2rpx;
  border-radius: 999rpx;
  background: #d7ded9;
}

.sidebar-top {
  display: flex;
  height: 102rpx;
  flex: 0 0 102rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx 0 34rpx;
  box-sizing: border-box;
}

.sidebar-title {
  color: #202126;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.15;
}

.sidebar-close-btn {
  display: flex;
  width: 66rpx;
  height: 66rpx;
  flex: 0 0 66rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #f0f3f1;
  color: #53635e;
}

.sidebar-close-btn:active {
  opacity: 0.86;
  transform: scale(0.96);
}

.sidebar-close-btn text {
  color: currentColor;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1;
}

.sidebar-list {
  flex: 1;
  min-height: 0;
  padding: 0 26rpx 30rpx;
  box-sizing: border-box;
}

.dir-item {
  position: relative;
  display: flex;
  min-height: 82rpx;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 18rpx 24rpx 18rpx 28rpx;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  background: rgba(249, 251, 249, 0.78);
  box-sizing: border-box;
  color: #202126;
  transition: opacity 0.18s ease, transform 0.18s ease;
}

.dir-item.active {
  border-color: rgba(246, 179, 90, 0.82);
  background:
    radial-gradient(circle at 96% 0%, rgba(246, 179, 90, 0.12), transparent 40%),
    #fff8ea;
  box-shadow: 0 10rpx 24rpx rgba(246, 179, 90, 0.12);
}

.dir-item.active::before {
  position: absolute;
  top: 50%;
  left: 18rpx;
  width: 11rpx;
  height: 11rpx;
  border-radius: 999rpx;
  background: #f5aa24;
  content: "";
  transform: translateY(-50%);
}

.dir-item:active {
  opacity: 0.92;
  transform: scale(0.985);
}

.dir-text {
  display: block;
  overflow: hidden;
  padding-left: 14rpx;
  color: inherit;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.38;
  text-overflow: ellipsis;
}

.main {
  position: relative;
  flex: 1;
  padding: 18rpx 34rpx calc(178rpx + constant(safe-area-inset-bottom));
  padding: 18rpx 34rpx calc(178rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f8f8f9;
}

.main.full {
  padding: 24rpx 40rpx calc(178rpx + constant(safe-area-inset-bottom));
  padding: 24rpx 40rpx calc(178rpx + env(safe-area-inset-bottom));
}

.card {
  min-height: 100%;
  padding-bottom: 32rpx;
  background: transparent;
}

.detail-header {
  margin-bottom: 24rpx;
  padding-top: 12rpx;
  padding-right: 144rpx;
}

.detail-top-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.tags-row {
  display: flex;
  min-width: 0;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag-pill {
  max-width: 280rpx;
  overflow: hidden;
  padding: 6rpx 15rpx;
  border-radius: 999rpx;
  background: #17181d;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-pill.secondary {
  background: #f0f3f1;
  color: #64746e;
}

.lesson-info {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.lesson-num,
.global-id {
  color: #a0a2aa;
  font-size: 20rpx;
  font-weight: 800;
}

.grammar-title {
  display: block;
  color: #202126;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.16;
}

.divider {
  width: 100%;
  height: 0;
}

.section-container {
  margin-bottom: 28rpx;
}

.section-label {
  display: block;
  margin-bottom: 16rpx;
  color: #8b8d96;
  font-size: 21rpx;
  font-weight: 900;
  letter-spacing: 0;
  line-height: 1.2;
}

.meaning-card {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
  border: 1rpx solid rgba(24, 25, 30, 0.05);
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 92% 0%, rgba(246, 179, 90, 0.1), transparent 34%),
    rgba(255, 255, 255, 0.92);
  box-shadow:
    0 16rpx 38rpx rgba(24, 25, 30, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.meaning-card::before {
  position: absolute;
  top: 30rpx;
  bottom: 30rpx;
  left: 0;
  width: 7rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: #17181d;
  content: "";
}

.meaning-content {
  margin-bottom: 28rpx;
  padding-left: 12rpx;
}

.meaning-text {
  margin-bottom: 18rpx;
  color: #202126;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.72;
  text-align: justify;
}

.meaning-text:last-child {
  margin-bottom: 0;
}

.info-box {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #f8faf8;
  box-shadow: inset 0 0 0 1rpx rgba(24, 25, 30, 0.04);
}

.info-badge {
  height: 40rpx;
  flex: 0 0 auto;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #17181d;
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.info-content {
  flex: 1;
  min-width: 0;
}

.info-text {
  margin-bottom: 8rpx;
  color: #64746e;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.62;
}

.info-text:last-child {
  margin-bottom: 0;
}

.section-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-count {
  padding: 7rpx 15rpx;
  border-radius: 999rpx;
  background: #f0f3f1;
  color: #8b8d96;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.example-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.example-card {
  position: relative;
  overflow: hidden;
  padding: 28rpx;
  border: 1rpx solid rgba(24, 25, 30, 0.05);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow:
    0 14rpx 34rpx rgba(24, 25, 30, 0.055),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
}

.example-card::after {
  position: absolute;
  top: -70rpx;
  right: -66rpx;
  width: 170rpx;
  height: 170rpx;
  border-radius: 999rpx;
  background: rgba(246, 179, 90, 0.08);
  content: "";
}

.example-card:active {
  opacity: 0.93;
  transform: scale(0.988);
}

.ex-kor-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.ex-num {
  min-width: 34rpx;
  color: #202126;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.45;
}

.ex-kor {
  flex: 1;
  min-width: 0;
  color: #202126;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.5;
}

.audio-icon {
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  margin-top: -4rpx;
  padding: 13rpx;
  border-radius: 999rpx;
  background: #17181d;
  box-sizing: border-box;
  opacity: 0.96;
}

.example-card:active .audio-icon {
  transform: scale(1.08);
}

.ex-trans-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding-left: 48rpx;
}

.ex-dash {
  width: 22rpx;
  height: 4rpx;
  flex: 0 0 22rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: #d5dbd7;
}

.ex-trans {
  flex: 1;
  min-width: 0;
  color: #777985;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.55;
}

.card-title,
.meta,
.body {
  display: none;
}

.empty {
  display: flex;
  min-height: 360rpx;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  color: #8b8d96;
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}
