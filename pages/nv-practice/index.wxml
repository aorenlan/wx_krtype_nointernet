<custom-nav subtitle="{{displayCategory}}" progress="{{words.length > 0 ? (currentIndex + 1) + ' / ' + words.length : ''}}" theme="light" bind:settings="openSettings" showSettingsTooltip="{{showSettingsTooltip}}" settingsTooltipText="{{settingsTooltipText}}"></custom-nav>

<view class="sleep-focus-page" wx:if="{{sleepFocusOpen}}" catchtap="stopSleepFocusMode" style="padding-top: {{statusBarHeight + 18}}px;">
  <view class="sleep-focus-top">
    <view class="sleep-focus-copy">
      <text class="sleep-focus-label">单词助眠</text>
      <text class="sleep-focus-summary">{{sleepActiveSummary}}</text>
    </view>
    <button class="sleep-focus-share" open-type="share" data-share-type="sleep" catchtap="preventBubble">分享</button>
  </view>
  <view class="sleep-focus-center">
    <text class="sleep-focus-progress">{{sleepWordLoopProgressText}}</text>
    <text class="sleep-focus-meaning">{{sleepWordLoopMeaning || '准备入睡'}}</text>
    <text class="sleep-focus-word">{{sleepWordLoopCurrent}}</text>
    <view class="sleep-focus-line"></view>
  </view>
  <view class="sleep-focus-bottom">
    <text class="sleep-focus-note">息屏或退后台可能中断，建议保持当前页面播放</text>
    <text>{{sleepRemainingText ? '点击任意处退出 · 剩余 ' + sleepRemainingText : '点击任意处退出'}}</text>
  </view>
</view>

<view class="container {{isKeyboardOpen ? 'keyboard-open' : ''}} {{showSettingsModal ? 'modal-open' : ''}} {{isIPad ? 'ipad-mode' : ''}}" style="padding-top: {{statusBarHeight + navBarHeight + 10}}px;" bindtap="focusHiddenInput">
  <input class="hidden-input" value="{{hiddenInputValue}}" focus="{{inputFocus}}" bindinput="onHiddenInput" bindblur="onHiddenInputBlur" maxlength="-1" />

  <!-- 每日一句入口 -->
  <view class="daily-sentence-entry" bindtap="openDailySentence">
    <view class="entry-left">
      <view class="entry-mark">
        <view class="entry-mark-dot"></view>
      </view>
      <text class="entry-title">每日一句</text>
    </view>
    <view class="entry-right">
      <text class="entry-source">{{dailySentenceEntrySource || ''}}</text>
      <text class="entry-arrow">›</text>
    </view>
  </view>

  <view class="practice-top-tools {{practiceToolsOpen ? 'tools-open' : ''}}" wx:if="{{words.length > 0 && currentWord && !loading && !isKeyboardOpen}}">
    <view class="practice-new-btn {{practiceToolsOpen ? 'active' : ''}}" catchtap="togglePracticeTools" hover-class="none">
      <text>NEW!</text>
      <view class="practice-new-dot"></view>
    </view>
    <view class="practice-tools-popover" wx:if="{{practiceToolsOpen}}" style="top: {{statusBarHeight + navBarHeight + 116}}px;">
      <view class="practice-glass-btn {{dualColumnMode ? 'active' : ''}}" catchtap="tapPracticeDualTool" hover-class="none">
        <view class="practice-glass-mark dual">
          <view></view>
          <view></view>
        </view>
        <view class="practice-glass-copy">
          <text class="practice-glass-title">双列</text>
          <text class="practice-glass-sub">{{dualColumnMode ? '拼记中' : '拼记'}}</text>
        </view>
      </view>
      <view class="practice-glass-btn sleep {{sleepPlaying ? 'active' : ''}}" catchtap="tapPracticeSleepTool" hover-class="none">
        <view class="practice-glass-mark sleep">眠</view>
        <view class="practice-glass-copy">
          <text class="practice-glass-title">单词助眠</text>
          <text class="practice-glass-sub">{{sleepPlaying ? sleepActiveSummary : '白噪音'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="sleep-sheet-mask" wx:if="{{sleepPanelOpen}}" catchtap="closeSleepPanel"></view>
  <view class="sleep-sheet" wx:if="{{sleepPanelOpen}}" catchtap="preventBubble">
    <view class="sleep-sheet-header">
      <view>
        <text class="sleep-sheet-title">单词助眠</text>
        <text class="sleep-sheet-sub">最多叠加 3 个声音，可与韩语朗读同时播放</text>
      </view>
      <view class="sleep-sheet-close" catchtap="closeSleepPanel">×</view>
    </view>

    <scroll-view class="sleep-sheet-body" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="sleep-control-panel">
        <view class="sleep-control-main">
          <view class="sleep-now-info">
            <text class="sleep-now-label">{{sleepPlaying ? '白噪音播放中' : '已选择'}}</text>
            <text class="sleep-now-title">{{sleepActiveSummary}}</text>
            <text class="sleep-now-timer" wx:if="{{sleepRemainingText}}">剩余 {{sleepRemainingText}}</text>
          </view>
          <view class="sleep-play-btn {{sleepPlaying ? 'playing' : ''}} {{sleepStarting ? 'starting' : ''}}" catchtap="toggleSleepMixer">
            {{sleepStarting ? '进入中' : (sleepPlaying ? '停止' : '进入')}}
          </view>
        </view>
        <view class="sleep-guide-card" wx:if="{{sleepGuideVisible}}">
          <view class="sleep-guide-mark">眠</view>
          <view class="sleep-guide-copy">
            <text class="sleep-guide-title">睡前这样用</text>
            <text class="sleep-guide-desc">选 1-3 个声音，点进入后会切到深色页循环读词；点屏幕任意处退出。</text>
          </view>
          <view class="sleep-guide-ok" catchtap="dismissSleepGuide">知道</view>
        </view>
        <view class="sleep-mixer-list" wx:if="{{sleepSelectedTracks.length}}">
          <view
            wx:for="{{sleepSelectedTracks}}"
            wx:key="id"
            class="sleep-mixer-row"
          >
            <view class="sleep-mixer-mark">{{item.mark}}</view>
            <view class="sleep-mixer-info">
              <text class="sleep-mixer-name">{{item.name}}</text>
              <text class="sleep-mixer-value">{{item.volumeText}}</text>
            </view>
            <slider
              class="sleep-mixer-slider"
              min="0"
              max="100"
              step="1"
              value="{{item.volume}}"
              activeColor="#17181d"
              backgroundColor="#e8edf3"
              block-size="13"
              data-id="{{item.id}}"
              catchtap="preventBubble"
              bindchange="changeSleepVolume"
              bindchanging="changeSleepVolume"
            />
            <view
              class="sleep-mixer-preview {{sleepPreviewingId === item.id ? 'playing' : ''}} {{sleepPreviewLoadingId === item.id ? 'loading' : ''}}"
              data-id="{{item.id}}"
              catchtap="tapSleepSound"
            >
              {{sleepPreviewLoadingId === item.id ? '…' : (sleepPreviewingId === item.id ? '停' : '听')}}
            </view>
            <view class="sleep-mixer-remove" data-id="{{item.id}}" catchtap="toggleSleepSound">×</view>
          </view>
        </view>
        <view class="sleep-cache-row" wx:if="{{!sleepCacheReady || sleepCacheDownloading}}">
          <view class="sleep-cache-meta">
            <text class="sleep-cache-label">音频缓存</text>
            <text class="sleep-cache-desc">{{sleepCacheStatusText}}</text>
          </view>
          <view class="sleep-cache-mini {{sleepCacheDownloading ? 'loading' : ''}}" catchtap="downloadAllSleepSounds">
            <text>{{sleepCacheDownloading ? sleepCacheButtonText : '一键下载'}}</text>
          </view>
        </view>
        <view class="sleep-cache-bar" wx:if="{{!sleepCacheReady && (sleepCacheDownloading || sleepCachePercent > 0)}}">
          <view class="sleep-cache-fill" style="width: {{sleepCachePercent}}%;"></view>
        </view>
        <view class="sleep-option-row">
          <picker class="sleep-choice-picker timer" mode="selector" range="{{sleepTimerOptions}}" range-key="label" value="{{sleepTimerPickerIndex}}" bindchange="onSleepTimerPickerChange">
            <view class="sleep-choice-pill">
              <text class="sleep-choice-label">定时</text>
              <text class="sleep-choice-value">{{sleepTimerLabel}}</text>
              <text class="sleep-choice-arrow">⌄</text>
            </view>
          </picker>
          <view class="sleep-choice-pill read-toggle {{sleepReadMeaning ? 'active' : ''}}" catchtap="toggleSleepReadMeaning">
            {{sleepReadMeaning ? '读中文' : '不读中文'}}
          </view>
          <picker class="sleep-choice-picker repeat" mode="selector" range="{{sleepKoreanRepeatPickerOptions}}" value="{{sleepKoreanRepeatPickerIndex}}" bindchange="onSleepKoreanRepeatPickerChange">
            <view class="sleep-choice-pill">
              <text class="sleep-choice-label">韩语</text>
              <text class="sleep-choice-value">{{sleepKoreanRepeatLabel}}</text>
              <text class="sleep-choice-arrow">⌄</text>
            </view>
          </picker>
        </view>
      </view>

      <view class="sleep-category-head">
        <text>分类</text>
        <text class="sleep-category-count">{{sleepCacheTotal}} 个声音</text>
      </view>
      <scroll-view class="sleep-category-scroll" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="sleep-category-row">
          <view
            wx:for="{{sleepCategories}}"
            wx:key="id"
            class="sleep-category-chip {{sleepActiveCategoryId === item.id ? 'active' : ''}}"
            data-id="{{item.id}}"
            catchtap="selectSleepCategory"
          >
            <text class="sleep-category-mark">{{item.mark}}</text>
            <text>{{item.titleZh}}</text>
          </view>
        </view>
      </scroll-view>

      <view class="sleep-section-title">环境音</view>
      <view class="sleep-sound-grid">
        <view
          wx:for="{{sleepSoundOptions}}"
          wx:key="id"
          class="sleep-sound-card {{item.selected ? 'selected' : ''}} {{item.cached ? 'cached' : ''}} {{sleepPreviewingId === item.id ? 'previewing' : ''}} {{sleepPreviewLoadingId === item.id ? 'loading' : ''}}"
          data-id="{{item.id}}"
          catchtap="tapSleepSound"
        >
          <view class="sleep-card-mainline">
            <view class="sleep-card-mark">{{item.mark}}</view>
            <view class="sleep-card-copy">
              <view class="sleep-card-name-row">
                <text class="sleep-card-name">{{item.name}}</text>
                <text class="sleep-card-desc">{{item.desc}}</text>
              </view>
              <view class="sleep-card-actions">
                <view class="sleep-preview-btn {{sleepPreviewingId === item.id ? 'playing' : ''}} {{sleepPreviewLoadingId === item.id ? 'loading' : ''}}" data-id="{{item.id}}" catchtap="tapSleepSound">
                  {{sleepPreviewLoadingId === item.id ? '加载' : (sleepPreviewingId === item.id ? '暂停' : '试听')}}
                </view>
                <text class="sleep-card-cache {{item.cached ? 'ready' : ''}}">{{sleepPreviewLoadingId === item.id ? '下载' : (item.cached ? '本地' : '在线')}}</text>
              </view>
            </view>
            <view class="sleep-card-select {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" catchtap="toggleSleepSound">
              {{item.selected ? '已选' : '加入'}}
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="dual-column-panel" wx:elif="{{dualColumnMode && !isKeyboardOpen && currentWord}}">
    <view class="dual-column-header">
      <view class="dual-column-title">
        <view class="dual-title-mark">
          <view></view>
          <view></view>
        </view>
        <text>左右列拼记</text>
      </view>
      <text class="dual-column-count">{{currentIndex + 1}} / {{words.length}}</text>
    </view>

    <view class="dual-control-panel">
      <view class="dual-control-right">
        <view class="dual-mode-switch">
          <view class="dual-mode-option {{!dualReciteMode ? 'active' : ''}}" data-mode="spell" catchtap="toggleDualReciteMode">拼写</view>
          <view class="dual-mode-option {{dualReciteMode ? 'active' : ''}}" data-mode="recite" catchtap="toggleDualReciteMode">背诵</view>
        </view>
        <view class="dual-visibility-cycle mode-{{dualVisibilityMode}}" catchtap="cycleDualVisibility">
          <view class="dual-visibility-copy">
            <text class="dual-visibility-key">显示</text>
            <text class="dual-visibility-value">{{dualVisibilityLabel}}</text>
          </view>
          <view class="dual-visibility-action">
            <text>切换</text>
            <text class="dual-visibility-cycle-icon">↻</text>
          </view>
        </view>
      </view>
    </view>

    <view class="dual-column-labels">
      <text>单词</text>
      <text>释义</text>
    </view>

    <scroll-view
      scroll-y
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
      scroll-into-view="{{dualScrollIntoView}}"
      class="dual-column-list"
    >
      <view
        id="dual-row-{{item.index}}"
        class="dual-word-row {{item.active ? 'active' : ''}} {{item.completed ? 'completed' : ''}} {{item.justCompleted ? 'just-completed' : ''}}"
        wx:for="{{dualColumnRows}}"
        wx:key="rowKey"
        catchtap="selectDualColumnWord"
        data-index="{{item.index}}"
      >
        <view class="dual-word-mainline">
          <view class="dual-word-cell dual-word-left">
            <text class="dual-index">{{item.indexLabel}}</text>
            <view class="dual-word-main">
              <view wx:if="{{item.active && !item.completed && !dualReciteMode}}" class="dual-input-row">
                <input
                  class="dual-native-input"
                  value="{{item.inputValue}}"
                  focus="{{item.inputFocus}}"
                  placeholder="输入单词"
                  placeholder-class="dual-native-placeholder"
                  confirm-type="next"
                  adjust-position="{{false}}"
                  cursor-spacing="0"
                  hold-keyboard="{{true}}"
                  auto-blur="{{false}}"
                  data-index="{{item.index}}"
                  bindinput="onDualNativeInput"
                  bindconfirm="onDualNativeConfirm"
                  bindfocus="focusDualNativeInput"
                  bindblur="blurDualNativeInput"
                  catchtap="focusDualNativeInput"
                />
              </view>
              <text wx:else class="dual-word-text {{dualReciteMode ? 'recite' : (item.completed ? 'completed' : 'muted')}} {{item.wordHidden ? 'hidden-word' : ''}}">{{item.displayWord}}</text>
              <view class="dual-progress-track" wx:if="{{item.active && !dualReciteMode}}">
                <view class="dual-progress-fill" style="width: {{item.progress}}%;"></view>
              </view>
            </view>
          </view>

          <view class="dual-word-cell dual-word-right">
            <view class="dual-meaning-wrap">
              <text class="dual-meaning {{item.meaningHidden ? 'hidden-meaning' : ''}}">{{item.displayMeaning}}</text>
              <text class="dual-phonetic" wx:if="{{item.phonetic}}">{{item.phonetic}}</text>
            </view>
            <view wx:if="{{dualReciteMode}}" class="dual-status dual-status-listen {{item.active ? 'active' : ''}}">听</view>
            <view wx:elif="{{item.active && !item.completed}}" class="dual-status dual-status-hint {{dualRevealWord ? 'active' : ''}}" catchtap="revealDualKoreanWord">提示</view>
            <text wx:else class="dual-status">{{item.completed ? '✓' : ''}}</text>
          </view>
        </view>

        <view class="dual-example-strip {{sentenceAudioIndex == item.index && sentenceAudioState == 'loading' ? 'audio-loading' : ''}} {{sentenceAudioIndex == item.index && sentenceAudioState == 'playing' ? 'audio-playing' : ''}}" wx:if="{{item.showExample}}" catchtap="playDualExampleAudio" data-index="{{item.index}}">
          <view class="dual-example-audio-state" wx:if="{{sentenceAudioIndex == item.index && sentenceAudioState}}">
            <view class="dual-example-audio-dot"></view>
            <text>{{sentenceAudioState == 'playing' ? '播放中' : '准备中'}}</text>
          </view>
          <text class="dual-example-sentence" wx:if="{{item.exampleSentence}}">{{item.exampleSentence}}</text>
          <text class="dual-example-translation" wx:if="{{item.exampleTranslation}}">{{item.exampleTranslation}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="dual-keyboard-dismiss" wx:if="{{dualNativeInputFocus}}" catchtap="hideDualNativeKeyboard">⌄</view>
  </view>

  <!-- Main Card -->
  <view class="card-container {{isKeyboardOpen ? 'keyboard-open' : ''}}" wx:elif="{{currentWord}}">
    
    <view class="card-stack {{prevWordInfo ? 'has-prev' : ''}}">
      <!-- Previous Word Indicator (Ticket Style) -->
      <view class="prev-word-ticket-wrap {{prevWordInfo ? 'show' : ''}}" wx:if="{{prevWordInfo}}">
          <view class="prev-tag {{prevWordInfo.isCorrect ? 'correct' : 'wrong'}}">PREV</view>
          <view class="prev-content">
              <text class="prev-kr">{{prevWordInfo.word}}</text>
              <text class="prev-cn">{{prevWordInfo.meaning}}</text>
          </view>
      </view>

      <view class="card {{isError ? 'shake' : ''}}">
        <!-- Card Top: Mode & Actions -->
        <view class="card-top-bar">
            <view class="top-left-group">
                <view class="focus-mode-btn" bindtap="toggleFocusMode">F</view>
            </view>
            <view class="card-actions">
                <view class="action-icon shuffle-action-icon {{isShuffled ? 'shuffle-on' : ''}}" catchtap="toggleShuffle" hover-class="none">
                    <image src="/assets/icons/shuffle.svg" style="width: 15px; height: 15px;" mode="aspectFit" />
                    <view class="shuffle-guide {{showShuffleGuide ? 'show' : ''}}">打乱单词</view>
                </view>
                <view class="action-icon" bindtap="playWordAudio" hover-class="none">
                    <image src="/assets/icons/volume.svg" style="width: 21px; height: 21px;" mode="aspectFit" />
                </view>
                <view class="action-icon" bindtap="removeCurrentFromMistakes" wx:if="{{settings.category === 'Mistakes (错题本)'}}">
                    <text style="font-size: 12px; color: #ef4444;">移出</text>
                </view>
                <!-- 待复习胶囊：紧贴card-actions右侧 -->
                <view wx:if="{{srsCount > 0 && !isKeyboardOpen && settings.srsEnabled}}" class="srs-capsule-inline" bindtap="openSrsReview">
                    <text class="srs-capsule-icon">🔥</text>
                    <text class="srs-capsule-text">待复习·{{srsCount}}</text>
                </view>
            </view>

            <!-- Shuffle Toast -->
            <view class="shuffle-toast {{showShuffleToast ? 'show' : ''}}">
                <text>{{shuffleToastText}}</text>
            </view>
        </view>

        <!-- Card Body -->
        <view class="card-body">
            <view class="nav-arrow left" bindtap="prevWord">
                <text>‹</text>
            </view>
            
            <view class="word-content" bindtap="showWordDetail">
                <view class="word-tooltip" wx:if="{{showWordTooltip}}" catchtap="dismissWordTooltip">
                    <text>点击单词可查看例句</text>
                    <view class="tooltip-arrow"></view>
                </view>

                <!-- Meaning (Chinese) -->
                <view class="meaning-container {{settings.cardShowMeaning ? '' : 'keep-space-hidden'}}">
                  <text class="meaning {{meaningIsSmall || currentWord.meaning.length > 7 ? 'meaning-small' : ''}}">{{currentWord.meaning}}</text>
                </view>

                <!-- Korean Word Slots -->
                <view id="nvLineMeasure" class="nv-text-line nv-text-line-measure">
                  <block wx:for="{{measureChars}}" wx:key="index">
                    <text class="nv-char text-gray">{{item}}</text>
                  </block>
                </view>

                <view wx:if="{{useLegacyWrapMode}}" class="nv-legacy-line {{(settings.cardShowWord || typingState.userInput.length > 0 || helpReveal) ? '' : 'keep-space-hidden'}}">
                  <block wx:if="{{isWordVisible || typingState.userInput.length > 0 || helpReveal}}">
                    <block wx:for="{{legacyDisplayChars}}" wx:key="index">
                      <text
                        class="nv-char legacy-char {{item.isCenter ? 'legacy-center' : ''}} {{item.status === 'done' ? 'text-green' : (item.status === 'active' ? 'text-yellow' : 'text-gray')}}"
                        style="{{item.status === 'active' ? 'background: linear-gradient(to right, #34d399 ' + item.progress + '%, #94a3b8 ' + item.progress + '%); -webkit-background-clip: text; color: transparent;' : ''}}"
                      >{{item.char}}</text>
                    </block>
                  </block>
                </view>

                <view wx:else class="nv-text-line {{(settings.cardShowWord || typingState.userInput.length > 0 || helpReveal) ? '' : 'keep-space-hidden'}}">
                  <block wx:if="{{isWordVisible || typingState.userInput.length > 0 || helpReveal}}">
                    <block wx:for="{{displayChars}}" wx:key="index">
                      <text
                        class="nv-char {{item.status === 'done' ? 'text-green' : (item.status === 'active' ? 'text-yellow' : 'text-gray')}}"
                        style="{{item.status === 'active' ? 'background: linear-gradient(to right, #34d399 ' + item.progress + '%, #94a3b8 ' + item.progress + '%); -webkit-background-clip: text; color: transparent;' : ''}}"
                      >{{item.char}}</text>
                    </block>
                  </block>
                </view>
            </view>

            <view class="nav-arrow right" bindtap="nextWord">
                <text>›</text>
            </view>

        </view>
      </view>
    </view>
  </view>

  <!-- Empty State -->
  <view class="empty-state" wx:else>
      <view class="empty-card">
        <view class="empty-mark">
          <view class="empty-mark-core"></view>
        </view>
        <text class="empty-kicker">{{displayCategory || settings.category || '当前词书'}}</text>
        <text class="empty-title">暂无可练习单词</text>
        <text class="empty-subtitle">可能是词书还在同步，或这个分类暂时没有内容。</text>
        <view class="empty-actions">
          <button bindtap="loadWords" class="empty-action primary">重新加载</button>
          <button bindtap="openSettings" class="empty-action secondary">切换词书</button>
        </view>
      </view>
  </view>

  <!-- Keyboard -->
  <view class="keyboard-wrapper {{isKeyboardOpen ? 'open' : 'closed'}}">
      <view class="keyboard-header-row">
        <view class="keyboard-header-left">
          <view class="keyboard-icon-btn" bindtap="onHelpReveal">
            <image src="/assets/tabbar/re_eye.png" class="keyboard-action-icon" mode="aspectFit" />
          </view>
          <block wx:if="{{settings.category === 'Mistakes (错题本)'}}">
            <view class="keyboard-mistake-pill">
              <image src="/assets/tabbar/re_错题本.png" class="keyboard-action-icon" mode="aspectFit" />
              <text class="keyboard-pill-text">{{currentIndex + 1}}/{{words.length}}</text>
            </view>
          </block>
        </view>

        <view class="keyboard-header-center" bindtap="toggleKeyboard">
          <view class="keyboard-handle-bar"></view>
        </view>

        <view class="keyboard-header-right">
          <block wx:if="{{settings.category !== 'Mistakes (错题本)'}}">
            <view class="keyboard-icon-btn" bindtap="addToMistakes">
              <image src="/assets/tabbar/re_错题本.png" class="keyboard-action-icon" mode="aspectFit" />
            </view>
          </block>
          <view class="keyboard-icon-btn keyboard-close-btn" bindtap="toggleKeyboard">
            <text class="keyboard-close-text">⌄</text>
          </view>
        </view>
      </view>

      <keyboard 
        id="keyboard"
        theme="light"
        nextKeyToPress="{{typingState.nextKey === 'SPACE' ? 'SPACE' : (settings.enableKeyboardHint ? (typingState.nextKey || '') : '')}}"
        isShiftActive="{{typingState.isShiftActive}}"
        visualMode="{{settings.keyboardVisualMode}}"
        bind:keyPress="onKeyPress"
      />
  </view>

  <view class="keyboard-expand-fab" wx:if="{{!isKeyboardOpen && !dualColumnMode}}" bindtap="toggleKeyboard">
    <text class="keyboard-expand-icon">⌃</text>
  </view>

  <view class="guide-bubble" wx:if="{{showGuideBubble}}" bindtap="onGuideBubbleClick">
    <text>点击唤起键盘</text>
    <view class="guide-arrow"></view>
  </view>

  <!-- Word Detail Modal -->
  <view class="detail-overlay {{showDetailModal ? 'show' : ''}} {{isKeyboardOpen ? 'keyboard-open' : ''}}" bindtap="closeDetailModal">
    <view class="detail-card {{sentenceAudioState == 'loading' ? 'sentence-loading' : ''}} {{sentenceAudioState == 'playing' ? 'sentence-playing' : ''}}" catchtap="playSentenceAudio">
      <view class="detail-header">
        <text class="detail-title">例句学习</text>
        <view wx:if="{{currentWord.word}}" class="detail-play-btn" catchtap="playWordAudio">
          <image src="/assets/icons/volume.svg" style="width:20px;height:20px;" mode="aspectFit" />
          <text class="detail-play-text">朗读单词</text>
        </view>
        <view class="detail-close" catchtap="closeDetailModal">×</view>
      </view>
      <scroll-view scroll-y class="detail-body" enhanced="{{true}}" show-scrollbar="{{false}}" bounces="{{true}}">
        <view class="detail-section">
            <view class="detail-row">
                <view class="detail-label-row">
                  <text class="detail-label">例句</text>
                  <image src="../../assets/icons/volume.svg" class="detail-audio-icon" />
                  <text class="detail-audio-state" wx:if="{{sentenceAudioState}}">{{sentenceAudioState == 'playing' ? '播放中' : '准备中'}}</text>
                </view>
                <text class="detail-text korean">{{currentWord.example_sentence || '暂无例句'}}</text>
            </view>
        </view>
        <view class="detail-section" wx:if="{{currentWord.sentence_translation}}">
             <view class="detail-row">
                <text class="detail-label">释义</text>
                <text class="detail-text chinese">{{currentWord.sentence_translation}}</text>
            </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- Settings Modal -->
  <view class="modal-overlay {{showSettingsModal ? 'show' : ''}}" bindtap="closeSettings">
    <view class="modal-content" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title" bindtap="onDevTriggerTap">设置</text>
      </view>
      
      <scroll-view scroll-y class="modal-body" enhanced="{{true}}" show-scrollbar="{{false}}" bounces="{{true}}">
        <view class="setting-section">
          <view class="section-title">词书</view>
          <picker mode="selector" range="{{categories}}" value="{{categoryPickerIndex}}" bindchange="onCategoryPickerChange">
            <view class="category-item picker-item">
              <text class="picker-label">选择词书</text>
              <view class="picker-right">
                <text class="picker-value">{{settings.category}}</text>
                <text class="picker-arrow">›</text>
              </view>
            </view>
          </picker>
        </view>

        <view class="setting-section" wx:if="{{showTopikSub}}">
          <view class="section-title">选择二级分类</view>
          <picker mode="selector" range="{{topikLevels}}" value="{{topikLevelPickerIndex}}" bindchange="onTopikLevelPickerChange">
            <view class="category-item picker-item">
              <text class="picker-label">TOPIK 等级</text>
              <view class="picker-right">
                <text class="picker-value">TOPIK {{settings.topikLevel}}</text>
                <text class="picker-arrow">›</text>
              </view>
            </view>
          </picker>

          <view class="topik-session" wx:if="{{topikSessions.length}}">
            <text class="picker-label">Session</text>
            <scroll-view scroll-x class="topik-session-scroll" show-scrollbar="{{false}}">
              <view class="topik-session-row">
                <block wx:for="{{topikSessions}}" wx:key="*this">
                  <view class="topik-session-chip {{settings.topikSession === item ? 'active' : ''}}" bindtap="selectTopikSession" data-session="{{item}}">
                    <text>{{item}}</text>
                  </view>
                </block>
              </view>
            </scroll-view>
          </view>
        </view>

        <view class="setting-section" wx:if="{{showYonseiSub}}">
          <view class="section-title">选择二级分类</view>
          <picker mode="selector" range="{{yonseiLessonOptions}}" value="{{yonseiLessonPickerIndex}}" bindchange="onYonseiLessonPickerChange">
            <view class="category-item picker-item">
              <text class="picker-label">课次 </text>
              <view class="picker-right">
                <text class="picker-value">{{yonseiLessonDisplay}}</text>
                <text class="picker-arrow">›</text>
              </view>
            </view>
          </picker>
        </view>

        <view class="setting-section">
          <text class="section-title">显示模式</text>
          <view class="mode-toggles">
            <view class="mode-btn {{settings.practiceMode === 'study' ? 'active' : ''}}" bindtap="updateSetting" data-key="practiceMode" data-value="study">
              <text>常驻显示</text>
              <text class="mode-btn-sub">Always Visible</text>
            </view>
            <view class="mode-btn {{settings.practiceMode === 'flash' ? 'active' : ''}}" bindtap="updateSetting" data-key="practiceMode" data-value="flash">
              <text>闪现模式</text>
              <text class="mode-btn-sub">Disappear</text>
            </view>
          </view>
        </view>

        <view class="setting-section">
          <view class="setting-row">
            <text>重复练习次数</text>
            <text class="setting-value">{{settings.repeatCount}}</text>
          </view>
          <slider min="1" max="10" step="1" value="{{settings.repeatCount}}" bindchange="updateSetting" data-key="repeatCount" activeColor="#17181d" block-size="20"/>
        </view>

        <view class="setting-section">
          <text class="section-title">键盘显示</text>
          <view class="mode-toggles">
            <view class="mode-btn {{settings.keyboardVisualMode === 'korean' ? 'active' : ''}}" bindtap="updateSetting" data-key="keyboardVisualMode" data-value="korean">
              <text>韩文在上</text>
              <text class="mode-btn-sub">KR / EN</text>
            </view>
            <view class="mode-btn {{settings.keyboardVisualMode === 'english' ? 'active' : ''}}" bindtap="updateSetting" data-key="keyboardVisualMode" data-value="english">
              <text>英文在上</text>
              <text class="mode-btn-sub">EN / KR</text>
            </view>
            <view class="mode-btn {{settings.keyboardVisualMode === 'korean_hide_english' ? 'active' : ''}}" bindtap="updateSetting" data-key="keyboardVisualMode" data-value="korean_hide_english">
              <text>仅韩文</text>
              <text class="mode-btn-sub">KR Only</text>
            </view>
            <view class="mode-btn {{settings.keyboardVisualMode === 'english_only' ? 'active' : ''}}" bindtap="updateSetting" data-key="keyboardVisualMode" data-value="english_only">
              <text>仅英文</text>
              <text class="mode-btn-sub">EN Only</text>
            </view>
          </view>
        </view>

        <!-- <view class="setting-section">
          <view class="setting-row">
            <text>自动倒计时</text>
            <switch checked="{{settings.enableTimer}}" color="#fad0c4" bindchange="toggleSetting" data-key="enableTimer"/>
          </view>
          <view wx:if="{{settings.enableTimer}}" class="slider-container">
            <view class="setting-row">
              <text class="sub-label">倒计时时长</text>
              <text class="setting-value">{{settings.timerDuration}}秒</text>
            </view>
            <slider min="3" max="30" step="1" value="{{settings.timerDuration}}" bindchange="updateSetting" data-key="timerDuration" activeColor="#fad0c4" block-size="20"/>
          </view>
        </view> -->

        <view class="setting-section">
          <text class="section-title">卡片内容</text>
          <view class="content-toggles">
            <view class="toggle-btn {{settings.cardShowWord ? 'active' : ''}}" bindtap="toggleSetting" data-key="cardShowWord">
              <text>显示单词</text>
              <view class="toggle-indicator"></view>
            </view>
            <view class="toggle-btn {{settings.cardShowMeaning ? 'active' : ''}}" bindtap="toggleSetting" data-key="cardShowMeaning">
              <text>显示释义</text>
              <view class="toggle-indicator"></view>
            </view>
          </view>
        </view>

        <view class="setting-section" wx:if="{{settings.practiceMode === 'flash'}}">
          <view class="setting-row">
            <text>闪现时长</text>
            <text class="setting-value">{{settings.flashDuration}}ms</text>
          </view>
          <slider min="200" max="3000" step="100" value="{{settings.flashDuration}}" bindchange="updateSetting" data-key="flashDuration" activeColor="#17181d" block-size="20"/>
        </view>

        <view class="setting-section">
          <text class="section-title">功能选项</text>

          <!-- <view class="setting-item" bindtap="toggleSetting" data-key="autoCheckSpelling">
            <text>自动检查拼写</text>
            <switch checked="{{settings.autoCheckSpelling}}" color="#fad0c4" bindchange="toggleSetting" catchtap="preventBubble" data-key="autoCheckSpelling"/>
          </view> -->

          <view class="setting-item" bindtap="toggleSetting" data-key="enableKeyboardHint">
            <text>键盘提示</text>
            <switch checked="{{settings.enableKeyboardHint}}" color="#17181d" bindchange="toggleSetting" catchtap="preventBubble" data-key="enableKeyboardHint"/>
          </view>

          <view class="setting-item" bindtap="toggleSetting" data-key="autoPronounce">
            <text>自动朗读单词</text>
            <switch checked="{{settings.autoPronounce}}" color="#17181d" bindchange="toggleSetting" catchtap="preventBubble" data-key="autoPronounce"/>
          </view>

          <view class="setting-item" bindtap="toggleSetting" data-key="pronounceMeaning">
            <text>朗读中文释义</text>
            <switch checked="{{settings.pronounceMeaning}}" color="#17181d" bindchange="toggleSetting" catchtap="preventBubble" data-key="pronounceMeaning"/>
          </view>

          <view class="setting-item" bindtap="toggleSetting" data-key="autoPlaySentence">
            <text>自动朗读例句</text>
            <switch checked="{{settings.autoPlaySentence}}" color="#17181d" bindchange="toggleSetting" catchtap="preventBubble" data-key="autoPlaySentence"/>
          </view>

          <view class="setting-item" bindtap="toggleSetting" data-key="srsEnabled">
            <text>待复习功能</text>
            <switch checked="{{settings.srsEnabled}}" color="#17181d" bindchange="toggleSetting" catchtap="preventBubble" data-key="srsEnabled"/>
          </view>

        </view>
      </scroll-view>
    </view>
  </view>

  <canvas type="2d" id="shareCanvas" style="position: absolute; left: -9999px; top: 0; width: 375px; height: 300px;"></canvas>



  <!-- Nagging Mode Overlay -->
  <view class="nagging-overlay" wx:if="{{isNaggingMode}}" catchtouchmove="preventScroll" bindtap="handleNaggingOverlayTap">
    
    <!-- Top Controls -->
    <view class="nagging-top-actions" catchtap="preventBubble" catchtouchmove="preventBubble">
      <view wx:if="{{isEditingNaggingRepeatCount}}" class="nagging-progress-pill is-editing">
        <input
          class="nagging-count-input"
          type="number"
          maxlength="3"
          value="{{naggingRepeatCountPreview}}"
          focus="{{isEditingNaggingRepeatCount}}"
          confirm-type="done"
          bindinput="onNaggingRepeatCountInput"
          bindblur="commitNaggingRepeatCount"
          bindconfirm="commitNaggingRepeatCount"
        />
        <text class="nagging-count-unit">次</text>
      </view>
      <view wx:else class="nagging-progress-pill" catchtap="startEditingNaggingRepeatCount">
        <text class="nagging-progress-current">{{naggingRepeatProgress}}</text>
        <text class="nagging-progress-total">/{{settings.naggingRepeatCount}}</text>
      </view>
      <view class="nagging-style-switch" catchtap="toggleNaggingStyle">
        <text>{{naggingStyle === 'scatter' ? '切换:文章模式' : '切换:散落模式'}}</text>
      </view>
    </view>

    <!-- SCATTER MODE -->
    <block wx:if="{{naggingStyle === 'scatter'}}">
        <view class="nagging-bg">
            <block wx:for="{{naggingItems}}" wx:key="id">
                <view class="nagging-bg-item" 
                        style="top:{{item.top}}%; left:{{item.left}}%; font-size:{{item.fontSize}}px; opacity:0; --rotate:{{item.rotate}}deg">
                        {{item.word}}
                </view>
            </block>
        </view>
        <view class="nagging-center">
            <view class="nagging-cn-main">{{currentWord.meaning}}</view>
        </view>
    </block>

    <!-- FLOW MODE -->
    <block wx:if="{{naggingStyle === 'flow'}}">
        <scroll-view scroll-y class="nagging-flow-scroll" scroll-into-view="item-{{naggingItems.length > 0 ? naggingItems.length - 1 : ''}}">
            <view class="nagging-flow-container">
                <view class="nagging-flow-title">【{{currentWord.meaning}}】</view>
                <view class="nagging-flow-content">
                    <block wx:for="{{naggingItems}}" wx:key="id">
                        <text class="nagging-flow-word" id="item-{{index}}">{{item.word}}</text>
                    </block>
                </view>
            </view>
        </scroll-view>
    </block>

    <view class="nagging-tip">点击任意处退出唠叨模式</view>
  </view>
</view>

<view wx:if="{{showTapSceneGuide}}" class="tap-scene-guide-mask" catchtap="closeTapSceneGuide" catchtouchmove="preventScroll">
  <view class="tap-scene-guide-card" catchtap="preventBubble">
    <view class="tap-scene-guide-art">
      <image class="tap-scene-guide-image" src="{{tapSceneGuideImage}}" mode="aspectFill"></image>
      <view class="tap-scene-guide-image-mask"></view>
      <view class="tap-scene-guide-dot one"></view>
      <view class="tap-scene-guide-dot two"></view>
      <view class="tap-scene-guide-dot three"></view>
      <view class="tap-scene-guide-bubble">点</view>
    </view>
    <view class="tap-scene-guide-kicker">NEW · 看图点读</view>
    <view class="tap-scene-guide-title">图里的韩语，现在可以点着听</view>
    <view class="tap-scene-guide-copy">打开第二个「看图」页，点场景里的物品，直接听单词、例句和场景句。</view>
    <view class="tap-scene-guide-actions">
      <view class="tap-scene-guide-btn secondary" catchtap="closeTapSceneGuide">先不看</view>
      <view class="tap-scene-guide-btn primary" catchtap="goTapSceneFromGuide">去看看</view>
    </view>
  </view>
</view>

<!-- 开发者模拟按钮（fixed，必须在容器外） -->
<view wx:if="{{showDevBtn}}" class="debug-srs-fab" bindtap="debugSimulateNextDay">
  <text>🧪</text>
</view>
