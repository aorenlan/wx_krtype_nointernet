}

.photo-quota-dot {
  width: 13rpx;
  height: 13rpx;
  flex: 0 0 13rpx;
  border-radius: 999rpx;
  background: #f5a623;
  box-shadow: 0 0 0 8rpx rgba(245, 166, 35, 0.12);
}

.photo-quota-text {
  overflow: hidden;
  color: #7b817f;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.analysis-status {
  display: flex;
  max-width: 100%;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
  padding: 16rpx 22rpx;
  border: 1rpx solid rgba(24, 25, 30, 0.06);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 14rpx 34rpx rgba(24, 25, 30, 0.07);
}

.analysis-dot {
  width: 14rpx;
  height: 14rpx;
  flex: 0 0 14rpx;
  border-radius: 999rpx;
  background: #f5a623;
  box-shadow: 0 0 0 8rpx rgba(245, 166, 35, 0.12);
}

.analysis-status.is-live .analysis-dot {
  animation: status-pulse 1.1s ease-in-out infinite;
}

.analysis-text {
  overflow: hidden;
  color: #202126;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shared-word-card {
