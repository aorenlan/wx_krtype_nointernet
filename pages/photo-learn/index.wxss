  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #17181d;
  color: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(24, 25, 30, 0.16);
}

.history-link-icon .tab-journal-icon {
  width: 30rpx;
