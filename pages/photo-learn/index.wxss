.photo-page {
  min-height: 100vh;
  background: #f8f8f9;
  color: #202126;
}

.top-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #f8f8f9;
}

.top-title {
  color: #202126;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.top-share-btn {
  position: absolute;
  right: 28rpx;
  bottom: 14rpx;
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(24, 25, 30, 0.08);
}

.top-share-btn::after { border: none; }

.top-share-press {
  opacity: 0.86;
  transform: scale(0.96);
}

.top-share-icon {
  width: 28rpx;
  height: 28rpx;
}

.share-canvas {
  position: absolute;
  left: -9999px;
  top: 0;
  width: 500px;
  height: 400px;
  opacity: 0;
  pointer-events: none;
}

.home-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  align-items: center;
  padding-left: 40rpx;
  padding-right: 40rpx;
  padding-bottom: calc(260rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f8f8f9;
}

button::after {
  border: 0;
}

.hero-copy {
  width: 100%;
  text-align: center;
}

.app-title {
  display: block;
  color: #202126;
  font-size: 50rpx;
  font-weight: 900;
  line-height: 1.1;
}

.app-subtitle {
  position: relative;
  display: flex;
  width: 468rpx;
  min-height: 72rpx;
  max-width: 100%;
  margin: 18rpx auto 0;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  color: #8b8d96;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.45;
  transition: opacity 0.28s ease, transform 0.28s ease;
}

.hello-halo {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 0;
  width: 388rpx;
  max-width: calc(100vw - 120rpx);
  height: 50rpx;
  overflow: hidden;
  border-radius: 999rpx;
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, -50%) scale(0.94);
  animation: halo-in 0.42s ease-out 0.12s forwards;
}

.hello-halo::before {
  position: absolute;
  inset: -22rpx;
  border-radius: 50%;
  background:
    conic-gradient(
      from 0deg,
      transparent 0deg,
      transparent 246deg,
      rgba(29, 78, 216, 0.04) 268deg,
      rgba(29, 78, 216, 0.8) 292deg,
      rgba(255, 255, 255, 0.98) 306deg,
      rgba(245, 118, 64, 0.72) 322deg,
      transparent 340deg,
      transparent 360deg
    );
  content: "";
  filter: blur(0.6rpx);
  transform-origin: 50% 50%;
  animation: hello-halo-spin 6.8s linear infinite;
}

.hello-halo::after {
  position: absolute;
  inset: 5rpx;
  border-radius: inherit;
  background: #f8f8f9;
  box-shadow:
    inset 0 0 0 1rpx rgba(29, 78, 216, 0.03),
    inset 0 0 18rpx rgba(255, 255, 255, 0.7);
  content: "";
}

.subtitle-leaving {
  opacity: 0;
  transform: translateY(-8rpx) scale(0.98);
}

.type-char {
  position: relative;
  z-index: 1;
  display: inline-block;
  min-width: 1rpx;
  animation: type-pop 0.22s cubic-bezier(0.18, 0.9, 0.24, 1.25) both;
}

.tone-plain {
  color: #8b8d96;
}

.tone-ko {
  color: #0f766e;
}

.tone-en {
  color: #1d4ed8;
}

.tone-ja {
  color: #b45309;
}

.tone-muted {
  color: #a0a2aa;
}

.subtitle-final .type-char {
  font-weight: 900;
  animation:
    type-pop 0.24s cubic-bezier(0.18, 0.9, 0.24, 1.2) both,
    hello-color 2.8s ease-in-out infinite;
}

.typing-cursor {
  position: relative;
  z-index: 1;
  display: inline-block;
  width: 3rpx;
  height: 26rpx;
  margin-left: 6rpx;
  border-radius: 999rpx;
  background: #8b8d96;
  animation: cursor-blink 0.78s steps(2, start) infinite;
}

.capture-card {
  position: relative;
  display: flex;
  overflow: hidden;
  width: 348rpx;
  height: 304rpx;
  max-width: 72vw;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 74rpx;
  padding: 0;
  border: 0;
  border-radius: 42rpx;
  background: #17181d;
  color: #ffffff;
  line-height: normal;
  box-shadow: 0 34rpx 70rpx rgba(24, 25, 30, 0.18);
}

.capture-card.is-analyzing {
  opacity: 0.92;
}

.capture-card.is-analyzing .capture-shine {
  animation-duration: 1.15s;
}

.capture-press {
  opacity: 0.94;
  transform: scale(0.985);
}

.capture-shine {
  position: absolute;
  top: -120rpx;
  left: 50%;
  width: 420rpx;
  height: 220rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  filter: blur(12rpx);
  transform: translateX(-50%);
  animation: breathe 2.8s ease-in-out infinite;
}

.capture-icon {
  position: relative;
  z-index: 2;
  display: flex;
  width: 118rpx;
  height: 118rpx;
  align-items: center;
  justify-content: center;
  border-radius: 34rpx;
  background: #33333b;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.planet-system {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 1;
  width: 270rpx;
  height: 220rpx;
  margin-top: -126rpx;
  margin-left: -135rpx;
  pointer-events: none;
  transform-origin: 50% 50%;
  animation: orbit-spin 1.9s cubic-bezier(0.12, 0.72, 0.18, 1) 1 forwards;
}

.planet {
  position: absolute;
  border-radius: 999rpx;
  opacity: 0;
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.16);
  animation: planet-arrive 1.9s ease-out 1 forwards;
}

.planet-one {
  top: 12rpx;
  left: 56rpx;
  width: 18rpx;
  height: 18rpx;
  background: #777985;
}

.planet-two {
  top: 38rpx;
  right: 38rpx;
  width: 12rpx;
  height: 12rpx;
  background: #b9bbc2;
}

.planet-three {
  right: 24rpx;
  bottom: 54rpx;
  width: 22rpx;
  height: 22rpx;
  background: #585963;
}

.planet-four {
  bottom: 26rpx;
  left: 44rpx;
  width: 14rpx;
  height: 14rpx;
  background: #d9d9dd;
}

.planet-five {
  top: 96rpx;
  left: 12rpx;
  width: 10rpx;
  height: 10rpx;
  background: #90919a;
}

.camera-mark {
  position: relative;
  width: 54rpx;
  height: 42rpx;
}

.camera-bump {
  position: absolute;
  top: 0;
  left: 17rpx;
  width: 20rpx;
  height: 9rpx;
  border: 4rpx solid #ffffff;
  border-bottom: 0;
  border-radius: 7rpx 7rpx 0 0;
}

.camera-frame {
  position: absolute;
  bottom: 0;
  left: 0;
  display: flex;
  width: 54rpx;
  height: 35rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #ffffff;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.camera-lens {
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid #ffffff;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.capture-label {
  position: relative;
  z-index: 2;
  display: block;
  margin-top: 44rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.home-page.has-current-result .capture-card {
  width: 324rpx;
  height: 270rpx;
  margin-top: 54rpx;
  border-radius: 38rpx;
}

.home-page.has-current-result .capture-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 30rpx;
}

.home-page.has-current-result .capture-label {
  margin-top: 32rpx;
}

.photo-quota {
  display: flex;
  max-width: 100%;
  align-items: center;
  gap: 10rpx;
  margin-top: 26rpx;
  padding: 13rpx 19rpx;
  border: 1rpx solid rgba(24, 25, 30, 0.06);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 30rpx rgba(24, 25, 30, 0.06);
}

.photo-quota.is-empty {
  border-color: rgba(245, 166, 35, 0.26);
