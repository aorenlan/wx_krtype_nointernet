}

.current-result-head {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 18rpx;
}

.current-image {
  width: 126rpx;
  height: 126rpx;
  flex: 0 0 126rpx;
  border-radius: 26rpx;
  background: #eef0f3;
  box-shadow: 0 14rpx 26rpx rgba(24, 25, 30, 0.08);
}

.current-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 7rpx;
  text-align: left;
}

.current-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.current-kicker {
  color: #d28a16;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.current-count {
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #777985;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
}

.current-title {
  overflow: hidden;
  color: #202126;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.18;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.current-time {
  color: #9a9ca5;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
}

.current-words {
  width: 100%;
  max-height: 218rpx;
  flex: 1 1 auto;
  margin-top: 16rpx;
  overflow: hidden;
}

.current-word-grid {
  display: grid;
  width: 100%;
  box-sizing: border-box;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  padding-right: 4rpx;
  padding-bottom: 4rpx;
}

.current-word {
  position: relative;
  display: flex;
  min-width: 0;
  min-height: 66rpx;
  flex-direction: column;
  gap: 4rpx;
  justify-content: center;
  padding: 11rpx 16rpx;
  border: 1rpx solid rgba(24, 25, 30, 0.06);
  border-radius: 22rpx;
  background: rgba(248, 249, 249, 0.78);
  box-sizing: border-box;
  transition: transform 0.16s ease, border-color 0.16s ease, background 0.16s ease;
}

.current-word-ko,
.current-word-meaning {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.current-word-ko {
  color: #202126;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
}

.current-word-meaning {
  color: #7f8490;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
}

.current-word-press {
  transform: scale(0.98);
}

.current-word.is-speaking {
  border-color: rgba(251, 176, 38, 0.56);
  background: rgba(255, 248, 234, 0.96);
}

.current-word.is-speaking::after {
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #f5a623;
  box-shadow: 0 0 0 8rpx rgba(245, 166, 35, 0.12);
  content: "";
}

.current-empty {
  display: block;
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #f3f4f5;
  color: #8f929b;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
  text-align: center;
}

.audio-prep {
  display: flex;
  min-height: 62rpx;
  flex: 0 0 auto;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid rgba(24, 25, 30, 0.05);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.85);
  box-sizing: border-box;
}

.audio-prep-mark {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 34rpx;
  border-radius: 999rpx;
  background: #17181d;
  box-shadow: 0 8rpx 16rpx rgba(24, 25, 30, 0.14);
}

.audio-prep-mark::after {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #f5a623;
  content: "";
}

.audio-prep-wave {
  position: absolute;
  inset: -8rpx;
  border: 2rpx solid rgba(245, 166, 35, 0.28);
  border-radius: 999rpx;
  opacity: 0;
  animation: audio-wave 1.4s ease-out infinite;
}

.audio-prep-wave-two {
  animation-delay: 0.44s;
}

.audio-prep-ready .audio-prep-wave,
.audio-prep-partial .audio-prep-wave {
  display: none;
}

.audio-prep-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.audio-prep-title {
  overflow: hidden;
  color: #4d535f;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.audio-prep-track {
  overflow: hidden;
  width: 100%;
  height: 6rpx;
  border-radius: 999rpx;
  background: #edf0f1;
}

.audio-prep-bar {
  height: 100%;
  min-width: 8rpx;
  border-radius: inherit;
  background: linear-gradient(90deg, #f5a623, #ffd47a);
  transition: width 0.24s ease;
}

.audio-prep-count {
  flex: 0 0 auto;
  min-width: 58rpx;
  padding: 9rpx 12rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #777985;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
}

.audio-prep-ready {
  background: rgba(247, 252, 249, 0.92);
}

.audio-prep-ready .audio-prep-mark::after {
  background: #14b86a;
}

.audio-prep-ready .audio-prep-bar {
  background: linear-gradient(90deg, #14b86a, #89e0b4);
}

.audio-prep-partial {
  background: rgba(255, 250, 240, 0.92);
}

.current-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 14rpx;
  margin-top: 14rpx;
}

.current-practice,
.current-history-mini {
  display: flex;
  height: 70rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 900;
  line-height: normal;
}

.current-practice {
  background: #17181d;
  color: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(24, 25, 30, 0.16);
}

.current-history-mini {
  background: #f2f3f5;
  color: #59606b;
}

.current-practice-press,
.current-history-mini-press {
  opacity: 0.9;
  transform: scale(0.985);
}

.history-link {
  display: flex;
  width: 100%;
  min-height: 108rpx;
  align-items: center;
  gap: 18rpx;
  margin-top: 26rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(24, 25, 30, 0.05);
  border-radius: 999rpx;
  background:
    radial-gradient(circle at 90% 0%, rgba(246, 179, 90, 0.12), transparent 34%),
