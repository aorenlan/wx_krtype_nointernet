.history-link-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  text-align: left;
}

.history-link-title {
  color: #202126;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.15;
}

.history-link-subtitle {
  overflow: hidden;
  color: #9a9ca5;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-link-tail {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 8rpx;
}

.history-link-count {
  min-width: 62rpx;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #777985;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
}

.history-link-arrow {
  color: #a0a2aa;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.photo-quota-mask {
  position: fixed;
  inset: 0;
  z-index: 12000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 28rpx calc(34rpx + constant(safe-area-inset-bottom));
  padding: 0 28rpx calc(34rpx + env(safe-area-inset-bottom));
  background: rgba(24, 25, 30, 0.32);
  box-sizing: border-box;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.18s ease, visibility 0.18s ease;
  visibility: hidden;
}

.photo-quota-mask.is-visible {
  opacity: 1;
  pointer-events: auto;
  visibility: visible;
}

.photo-quota-dialog {
  position: relative;
  display: flex;
  width: 100%;
  max-width: 640rpx;
  flex-direction: column;
  align-items: center;
  padding: 42rpx 34rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 92% 8%, rgba(246, 179, 90, 0.18), transparent 34%),
    rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
  box-shadow:
    0 24rpx 70rpx rgba(24, 25, 30, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
}

.photo-quota-mask.is-visible .photo-quota-dialog {
  animation: quota-sheet-in 0.2s ease-out both;
}

.photo-quota-mark {
  position: relative;
  width: 70rpx;
  height: 70rpx;
  border-radius: 999rpx;
  background: #17181d;
  box-shadow: 0 14rpx 30rpx rgba(24, 25, 30, 0.16);
}

.photo-quota-mark::before {
  position: absolute;
  inset: 18rpx;
  border: 5rpx solid #ffffff;
  border-radius: 999rpx;
  content: "";
  opacity: 0.88;
}

.photo-quota-mark-dot {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: 19rpx;
  height: 19rpx;
  border: 4rpx solid #17181d;
  border-radius: 999rpx;
  background: #f5a623;
}

.photo-quota-title {
  display: block;
  margin-top: 22rpx;
  color: #202126;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.photo-quota-desc {
  display: block;
  max-width: 470rpx;
  margin-top: 14rpx;
  color: #7c827f;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.5;
  text-align: center;
}

.photo-quota-actions {
  display: flex;
  width: 100%;
  gap: 16rpx;
  margin-top: 28rpx;
}

.photo-quota-cancel,
.photo-quota-confirm {
  display: flex;
  height: 78rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 900;
  line-height: normal;
}

.photo-quota-cancel {
  background: #f1f3f3;
  color: #66716d;
}

.photo-quota-confirm {
  background: #17181d;
  color: #ffffff;
  box-shadow: 0 16rpx 34rpx rgba(24, 25, 30, 0.16);
}

.photo-quota-confirm.is-loading {
  opacity: 0.72;
}

.tab-journal-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid currentColor;
  border-radius: 999rpx;
}

.tab-journal-icon::before {
  position: absolute;
  top: 7rpx;
  left: 13rpx;
  width: 4rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: currentColor;
  content: "";
}

.tab-journal-icon::after {
  position: absolute;
  top: 15rpx;
  left: 13rpx;
  width: 11rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
  content: "";
}

.learn-wait-mask {
  position: fixed;
  inset: 0;
  z-index: 3200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(248, 248, 249, 0.72);
  backdrop-filter: blur(22rpx);
  box-sizing: border-box;
  animation: wait-mask-in 180ms ease-out both;
}

.learn-wait-card {
  width: 100%;
  max-width: 640rpx;
  padding: 38rpx 34rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 38rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.98), rgba(255, 250, 240, 0.95));
  box-shadow:
    0 34rpx 92rpx rgba(24, 25, 30, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
  box-sizing: border-box;
  animation: wait-card-in 220ms ease-out both;
}

.learn-wait-visual {
  position: relative;
  width: 250rpx;
  height: 198rpx;
  margin: 0 auto 18rpx;
}

.learn-wait-ring {
  position: absolute;
  top: 24rpx;
  left: 50%;
  width: 178rpx;
  height: 132rpx;
  margin-left: -89rpx;
  border: 2rpx solid rgba(24, 25, 30, 0.08);
  border-top-color: rgba(245, 170, 36, 0.8);
  border-radius: 50%;
  transform: rotate(-12deg);
  animation: wait-ring-spin 4.8s linear infinite;
}

.wait-ring-two {
  top: 38rpx;
  width: 212rpx;
  height: 104rpx;
  margin-left: -106rpx;
  border-top-color: rgba(29, 78, 216, 0.42);
  transform: rotate(18deg);
  animation-duration: 6.4s;
  animation-direction: reverse;
}

.learn-wait-core {
  position: absolute;
  top: 48rpx;
  left: 50%;
  display: flex;
  width: 102rpx;
  height: 102rpx;
  align-items: center;
  justify-content: center;
  margin-left: -51rpx;
  border-radius: 32rpx;
  background: #17181d;
  box-shadow: 0 20rpx 44rpx rgba(24, 25, 30, 0.18);
}

.wait-camera {
  position: relative;
  width: 48rpx;
  height: 38rpx;
}

.wait-camera-bump {
  position: absolute;
  top: 0;
  left: 15rpx;
  width: 18rpx;
  height: 8rpx;
  border: 4rpx solid #ffffff;
  border-bottom: 0;
  border-radius: 7rpx 7rpx 0 0;
  box-sizing: border-box;
}

.wait-camera-body {
  position: absolute;
  bottom: 0;
  left: 0;
  display: flex;
  width: 48rpx;
  height: 31rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #ffffff;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.wait-camera-lens {
  width: 15rpx;
  height: 15rpx;
  border: 4rpx solid #ffffff;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.wait-token {
  position: absolute;
  display: flex;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  border: 1rpx solid rgba(24, 25, 30, 0.06);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #68707a;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 1;
  box-shadow: 0 12rpx 28rpx rgba(24, 25, 30, 0.06);
  animation: wait-token-float 2.6s ease-in-out infinite;
}

.wait-token-one {
  top: 10rpx;
  left: 6rpx;
}

.wait-token-two {
  top: 20rpx;
  right: 0;
  animation-delay: 0.35s;
}

.wait-token-three {
  bottom: 4rpx;
  left: 76rpx;
  animation-delay: 0.68s;
}

.learn-wait-kicker,
.learn-wait-title,
.learn-wait-copy {
  display: block;
  text-align: center;
}

.learn-wait-kicker {
  color: #d48310;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 1;
}

.learn-wait-title {
  margin-top: 16rpx;
  color: #202126;
  font-size: 36rpx;
  font-weight: 950;
  line-height: 1.2;
}

.learn-wait-copy {
  max-width: 500rpx;
  margin: 16rpx auto 0;
  color: #737a82;
  font-size: 24rpx;
  font-weight: 750;
  line-height: 1.5;
}

.learn-wait-track {
  position: relative;
  height: 9rpx;
  overflow: hidden;
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: rgba(24, 25, 30, 0.08);
}

.learn-wait-bar {
  position: absolute;
  top: 0;
  left: -42%;
  width: 42%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #f5aa24, #1d4ed8);
  animation: wait-bar-run 1.72s ease-in-out infinite;
}

.learn-wait-steps {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.learn-wait-step {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  padding: 15rpx 8rpx;
  border-radius: 20rpx;
  background: rgba(247, 248, 249, 0.92);
}

.learn-wait-step-ko {
  color: #202126;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 1;
}

.learn-wait-step-cn {
  color: #8b9099;
  font-size: 18rpx;
  font-weight: 850;
  line-height: 1;
}

@keyframes breathe {
  0%,
  100% {
    opacity: 0.58;
    transform: translateX(-50%) scale(0.92);
  }

  50% {
    opacity: 1;
    transform: translateX(-50%) scale(1.08);
  }
}

@keyframes wait-mask-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes wait-card-in {
  from {
    opacity: 0;
    transform: translateY(20rpx) scale(0.985);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes wait-ring-spin {
  0% {
    transform: rotate(0deg);
  }

  100% {
    transform: rotate(360deg);
  }
}

@keyframes wait-token-float {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-8rpx);
  }
}

@keyframes wait-bar-run {
  0% {
    left: -42%;
  }

  52% {
    left: 38%;
  }

  100% {
    left: 100%;
  }
}

@keyframes status-pulse {
  0%,
  100% {
    opacity: 0.72;
    transform: scale(0.86);
  }

  50% {
    opacity: 1;
    transform: scale(1.12);
  }
}

@keyframes audio-wave {
  0% {
    opacity: 0.7;
    transform: scale(0.72);
  }

  100% {
    opacity: 0;
    transform: scale(1.5);
  }
}

@keyframes orbit-spin {
  0% {
    opacity: 0;
    transform: rotate(-140deg) scale(0.72);
  }

  22% {
    opacity: 1;
  }

  76% {
    transform: rotate(322deg) scale(1.04);
  }

  100% {
    opacity: 1;
    transform: rotate(352deg) scale(1);
  }
}

@keyframes planet-arrive {
  0% {
    opacity: 0;
    transform: scale(0.2);
  }

  36%,
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes halo-in {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.9);
  }

  100% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

@keyframes hello-halo-spin {
  0% {
    transform: rotate(0deg);
  }

  100% {
    transform: rotate(360deg);
  }
}

@keyframes hello-color {
  0%,
  100% {
    filter: saturate(1);
  }

  50% {
    filter: saturate(1.45) brightness(1.04);
  }
}

@keyframes type-pop {
  0% {
    opacity: 0;
    transform: translateY(8rpx) scale(0.72);
  }

  72% {
    opacity: 1;
    transform: translateY(-2rpx) scale(1.08);
  }

  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes quota-sheet-in {
  0% {
    opacity: 0;
    transform: translateY(34rpx) scale(0.98);
  }

  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes cursor-blink {
  0%,
  45% {
    opacity: 1;
  }

  46%,
  100% {
    opacity: 0;
  }
}
