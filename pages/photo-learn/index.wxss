  margin-top: 22rpx;
}

.shared-word-item {
  min-width: 0;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(24, 25, 30, 0.06);
  border-radius: 18rpx;
  background: #fafafa;
