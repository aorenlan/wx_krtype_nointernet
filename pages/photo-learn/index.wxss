  font-weight: 900;
  line-height: 1.18;
}

.shared-count {
  flex: 0 0 auto;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: #eef3ff;
  color: #1d4ed8;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1;
}

.shared-word-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
