  color: #8b8d96;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.current-result {
  display: flex;
  width: 100%;
  max-height: 628rpx;
  flex-direction: column;
  margin-top: 28rpx;
  margin-bottom: 28rpx;
  padding: 22rpx;
  overflow: hidden;
  border: 1rpx solid rgba(24, 25, 30, 0.05);
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 100% 0%, rgba(246, 179, 90, 0.12), transparent 38%),
    rgba(255, 255, 255, 0.92);
  box-sizing: border-box;
  box-shadow:
    0 20rpx 54rpx rgba(24, 25, 30, 0.08),
