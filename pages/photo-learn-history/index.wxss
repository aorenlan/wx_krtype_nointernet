.history-page {
  min-height: 100vh;
  background: #f8f8f9;
  color: #202126;
}

.top-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: rgba(248, 248, 249, 0.92);
  backdrop-filter: blur(24rpx);
}

.top-title {
  color: #202126;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
}

.back-button {
  position: absolute;
  left: 34rpx;
  bottom: 14rpx;
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #202126;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 56rpx;
  box-shadow: 0 12rpx 30rpx rgba(24, 25, 30, 0.08);
}

button::after {
  border: 0;
}

.button-press,
.record-card-press {
  opacity: 0.9;
  transform: scale(0.986);
}

.history-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.summary-card,
.record-list,
.empty-card {
  margin-left: 40rpx;
  margin-right: 40rpx;
}

.summary-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(24, 25, 30, 0.05);
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 90% 0%, rgba(246, 179, 90, 0.14), transparent 36%),
    rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 46rpx rgba(24, 25, 30, 0.08);
}

.summary-icon,
.empty-icon {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #17181d;
  color: #ffffff;
}

.summary-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 7rpx;
}

.summary-title {
  color: #202126;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.15;
}

.summary-subtitle {
  color: #8f929b;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.25;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 26rpx;
  padding-bottom: calc(56rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.record-item {
  overflow: hidden;
  border: 1rpx solid rgba(24, 25, 30, 0.04);
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 100% 0%, rgba(246, 179, 90, 0.1), transparent 42%),
    rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 36rpx rgba(24, 25, 30, 0.06);
}

.record-card {
  display: flex;
  width: 100%;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 30rpx;
  background: transparent;
  box-sizing: border-box;
  color: #202126;
  line-height: normal;
  transition: background 160ms ease, transform 160ms ease;
}

.record-card.is-expanded {
  background: rgba(255, 255, 255, 0.72);
}

.record-image {
  width: 116rpx;
  height: 116rpx;
  flex: 0 0 116rpx;
  border-radius: 22rpx;
  background: #eef0f3;
}

.record-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  text-align: left;
}

.record-heading {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.record-title {
  overflow: hidden;
  min-width: 0;
  color: #202126;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-badge {
  flex: 0 0 auto;
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #777985;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
}

.record-desc,
.record-time {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-desc {
  color: #6d7280;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.25;
}

.record-time {
  color: #a0a3ad;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
}

.record-arrow {
  color: #b1b4bd;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
  transform: rotate(-90deg);
  transition: transform 160ms ease, color 160ms ease;
}

.record-arrow.is-open {
  color: #202126;
  transform: rotate(0deg);
}

.record-expand {
  padding: 0 18rpx 24rpx;
  animation: expand-in 160ms ease-out both;
}

@keyframes expand-in {
  from {
    opacity: 0;
    transform: translateY(-8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.expand-word-list {
  overflow: hidden;
  margin-bottom: 22rpx;
  border: 1rpx solid rgba(24, 25, 30, 0.07);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.82);
  box-sizing: border-box;
}

.expand-word-table-head {
  display: grid;
  height: 58rpx;
  align-items: center;
  grid-template-columns: 46% 54%;
  border-bottom: 1rpx solid rgba(24, 25, 30, 0.07);
  background: #f7f8f8;
  color: #a1a6af;
  font-size: 19rpx;
  font-weight: 900;
}

.expand-word-head-ko,
.expand-word-head-meaning {
  padding: 0 20rpx;
}

.expand-word {
  position: relative;
  display: grid;
  min-width: 0;
  min-height: 92rpx;
  align-items: stretch;
  grid-template-columns: 46% 54%;
  border-bottom: 1rpx solid rgba(24, 25, 30, 0.065);
  background: rgba(255, 255, 255, 0.68);
  box-sizing: border-box;
  transition: transform 0.16s ease, background 0.16s ease;
}

.expand-word:last-child {
  border-bottom: 0;
}

.expand-word-ko-cell,
.expand-word-meaning-cell {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
  padding: 15rpx 20rpx;
  box-sizing: border-box;
}

.expand-word-meaning-cell {
  justify-content: space-between;
  border-left: 1rpx solid rgba(24, 25, 30, 0.055);
}

.expand-word-index {
  flex: 0 0 auto;
  color: #c3c8d0;
  font-size: 17rpx;
  font-weight: 900;
}

.expand-word-ko {
  min-width: 0;
  color: #202126;
  font-size: 27rpx;
  font-weight: 950;
  line-height: 1.28;
  word-break: break-word;
}

.expand-word-meaning {
  min-width: 0;
  flex: 1;
  color: #707781;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 1.35;
  word-break: break-word;
}

.expand-word-listen {
  min-width: 48rpx;
  height: 48rpx;
  flex: 0 0 auto;
  padding: 0 11rpx;
  border: 1rpx solid rgba(24, 25, 30, 0.08);
  border-radius: 999rpx;
  background: #f5f6f7;
  color: #8b9099;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
}

.expand-word-press {
  transform: scale(0.98);
}

.expand-word.is-speaking {
  background: #f4f6f8;
}

.expand-word.is-speaking::after {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 7rpx;
  background: #17181d;
  content: "";
}

.expand-word.is-speaking .expand-word-listen {
  border-color: #17181d;
  background: #17181d;
  color: #ffffff;
}

.expand-empty {
  display: block;
  margin-bottom: 18rpx;
  color: #7d828c;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.45;
}

.record-actions {
  display: flex;
  gap: 14rpx;
  margin-left: 134rpx;
}

.practice-button,
.sentence-button {
  display: flex;
  width: 194rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 1;
}

.practice-button {
  background: #17181d;
  color: #ffffff;
  box-shadow: 0 16rpx 34rpx rgba(24, 25, 30, 0.16);
}

.sentence-button {
  border: 1rpx solid rgba(24, 25, 30, 0.06);
  background: #fff8ea;
  color: #202126;
  box-shadow: 0 14rpx 28rpx rgba(246, 179, 90, 0.12);
}

.sentence-button.is-loading {
  opacity: 0.72;
}

.practice-button-press {
  opacity: 0.9;
  transform: scale(0.98);
}

.practice-modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 500;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 40rpx 78rpx;
  background: rgba(24, 25, 30, 0.38);
  backdrop-filter: blur(14rpx);
  box-sizing: border-box;
  animation: modal-mask-in 160ms ease-out both;
}

.practice-modal {
  width: 100%;
  padding: 36rpx 34rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 96% 0%, rgba(246, 179, 90, 0.14), transparent 34%),
    rgba(255, 255, 255, 0.96);
  box-shadow:
    0 30rpx 80rpx rgba(24, 25, 30, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
  animation: modal-card-in 180ms ease-out both;
}

.modal-mark {
  position: relative;
  width: 58rpx;
  height: 58rpx;
  margin-bottom: 22rpx;
  border-radius: 999rpx;
  background: #17181d;
  box-shadow: 0 14rpx 30rpx rgba(24, 25, 30, 0.16);
}

.modal-mark::before {
  position: absolute;
  inset: 13rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.86);
  border-right-color: transparent;
  border-radius: 999rpx;
  content: "";
}

.modal-mark-dot {
  position: absolute;
  right: 10rpx;
  bottom: 9rpx;
  width: 17rpx;
  height: 17rpx;
  border-radius: 999rpx;
  background: #f5aa24;
  box-shadow: 0 0 0 5rpx rgba(245, 170, 36, 0.16);
}

.modal-title {
  display: block;
  color: #202126;
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1.18;
}

.modal-copy {
  display: block;
  margin-top: 12rpx;
  color: #70757f;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.5;
}

.modal-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 30rpx;
}

.modal-button {
  display: flex;
  height: 76rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 950;
  line-height: 1;
}

.modal-button.secondary {
  background: #eef2ef;
  color: #53635e;
}

.modal-button.primary {
  background: #17181d;
  color: #ffffff;
  box-shadow: 0 16rpx 34rpx rgba(24, 25, 30, 0.16);
}

.modal-button:active {
  opacity: 0.9;
  transform: scale(0.985);
}

.sentence-confirm-modal {
  padding-top: 34rpx;
}

.sentence-confirm-mark {
  background: #202126;
}

.sentence-confirm-check {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 22rpx;
  padding: 12rpx 16rpx 12rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(238, 242, 239, 0.88);
  color: #6f7672;
}

.sentence-confirm-box {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(24, 25, 30, 0.14);
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.sentence-confirm-check.is-checked .sentence-confirm-box {
  border-color: #17181d;
  background: #17181d;
}

.sentence-confirm-tick {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 1;
}

.sentence-confirm-text {
  color: #6f7672;
  font-size: 23rpx;
  font-weight: 850;
  line-height: 1;
}

.sentence-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 620;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 24rpx calc(24rpx + constant(safe-area-inset-bottom));
  padding: 0 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(24, 25, 30, 0.42);
  backdrop-filter: blur(16rpx);
  box-sizing: border-box;
  animation: modal-mask-in 160ms ease-out both;
}

.sentence-modal {
  display: flex;
  width: 100%;
  max-height: 82vh;
  flex-direction: column;
  padding: 28rpx 24rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 95% 4%, rgba(246, 179, 90, 0.18), transparent 34%),
    rgba(255, 255, 255, 0.97);
  box-shadow:
    0 32rpx 88rpx rgba(24, 25, 30, 0.24),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
  animation: modal-card-in 180ms ease-out both;
}

.sentence-modal-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sentence-modal-mark {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  flex: 0 0 60rpx;
  border-radius: 999rpx;
  background: #17181d;
  box-shadow: 0 14rpx 30rpx rgba(24, 25, 30, 0.16);
}

.sentence-modal-mark::before {
  position: absolute;
  inset: 15rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 8rpx;
  content: "";
}

.sentence-modal-mark-dot {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #f5aa24;
  box-shadow: 0 0 0 5rpx rgba(245, 170, 36, 0.16);
}

.sentence-modal-heading {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.sentence-modal-title {
  color: #202126;
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1.1;
}

.sentence-modal-subtitle {
  overflow: hidden;
  color: #8b8d96;
  font-size: 21rpx;
  font-weight: 850;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sentence-modal-close {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #eef2ef;
  color: #53635e;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1;
}

.sentence-summary {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(246, 179, 90, 0.28);
  border-radius: 24rpx;
  background: #fff8ea;
  color: #6d5d32;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.45;
}

.sentence-list {
  max-height: 58vh;
  margin-top: 18rpx;
}

.sentence-card {
  padding: 22rpx 22rpx 20rpx;
  border: 1rpx solid rgba(24, 25, 30, 0.05);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 32rpx rgba(24, 25, 30, 0.055);
}

.sentence-card + .sentence-card {
  margin-top: 16rpx;
}

.sentence-card-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sentence-word {
  color: #202126;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.15;
}

.sentence-meaning {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #777985;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.sentence-audio-btn {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  flex: 0 0 50rpx;
  align-items: center;
  justify-content: center;
  margin-left: auto;
  border-radius: 999rpx;
  background: #f0f3f1;
  box-shadow: inset 0 0 0 1rpx rgba(24, 25, 30, 0.04);
}

.sentence-audio-btn:active {
  opacity: 0.86;
  transform: scale(0.96);
}

.sentence-audio-btn.is-playing {
  background: #17181d;
  box-shadow: 0 10rpx 22rpx rgba(24, 25, 30, 0.14);
}

.sentence-audio-icon {
  width: 26rpx;
  height: 26rpx;
  opacity: 0.78;
}

.sentence-audio-btn.is-playing .sentence-audio-icon {
  filter: brightness(0) invert(1);
  opacity: 1;
}

.sentence-ko {
  display: block;
  margin-top: 16rpx;
  color: #202126;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.45;
}

.sentence-cn {
  display: block;
  margin-top: 9rpx;
  color: #5f6670;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.42;
}

.sentence-note {
  display: block;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(24, 25, 30, 0.06);
  color: #90949d;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.45;
}

.photo-quota-mask {
  position: fixed;
  inset: 0;
  z-index: 700;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 28rpx calc(34rpx + constant(safe-area-inset-bottom));
  padding: 0 28rpx calc(34rpx + env(safe-area-inset-bottom));
  background: rgba(24, 25, 30, 0.32);
  box-sizing: border-box;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.18s ease, visibility 0.18s ease;
  visibility: hidden;
}

.photo-quota-mask.is-visible {
  opacity: 1;
  pointer-events: auto;
  visibility: visible;
}

.photo-quota-dialog {
  position: relative;
  display: flex;
  width: 100%;
  max-width: 640rpx;
  flex-direction: column;
  align-items: center;
  padding: 42rpx 34rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 92% 8%, rgba(246, 179, 90, 0.18), transparent 34%),
    rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
  box-shadow:
    0 24rpx 70rpx rgba(24, 25, 30, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
}

.photo-quota-mask.is-visible .photo-quota-dialog {
  animation: modal-card-in 180ms ease-out both;
}

.photo-quota-mark {
  position: relative;
  width: 70rpx;
  height: 70rpx;
  border-radius: 999rpx;
  background: #17181d;
  box-shadow: 0 14rpx 30rpx rgba(24, 25, 30, 0.16);
}

.photo-quota-mark::before {
  position: absolute;
  inset: 18rpx;
  border: 5rpx solid #ffffff;
  border-radius: 999rpx;
  content: "";
  opacity: 0.88;
}

.photo-quota-mark-dot {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: 19rpx;
  height: 19rpx;
  border: 4rpx solid #17181d;
  border-radius: 999rpx;
  background: #f5a623;
}

.photo-quota-title {
  display: block;
  margin-top: 22rpx;
  color: #202126;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.photo-quota-desc {
  display: block;
  max-width: 470rpx;
  margin-top: 14rpx;
  color: #7c827f;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.5;
  text-align: center;
}

.photo-quota-actions {
  display: flex;
  width: 100%;
  gap: 16rpx;
  margin-top: 28rpx;
}

.photo-quota-cancel,
.photo-quota-confirm {
  display: flex;
  height: 78rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 900;
  line-height: normal;
}

.photo-quota-cancel {
  background: #f1f3f3;
  color: #66716d;
}

.photo-quota-confirm {
  background: #17181d;
  color: #ffffff;
  box-shadow: 0 16rpx 34rpx rgba(24, 25, 30, 0.16);
}

.photo-quota-confirm.is-loading {
  opacity: 0.72;
}

.sentence-wait-mask {
  position: fixed;
  inset: 0;
  z-index: 760;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 34rpx calc(72rpx + constant(safe-area-inset-bottom));
  padding: 0 34rpx calc(72rpx + env(safe-area-inset-bottom));
  background: rgba(24, 25, 30, 0.36);
  backdrop-filter: blur(16rpx);
  box-sizing: border-box;
  animation: modal-mask-in 160ms ease-out both;
}

.sentence-wait-card {
  width: 100%;
  max-width: 640rpx;
  padding: 36rpx 32rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 36rpx;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.98), rgba(255, 249, 236, 0.96));
  box-shadow:
    0 30rpx 86rpx rgba(24, 25, 30, 0.24),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
  box-sizing: border-box;
  animation: modal-card-in 190ms ease-out both;
}

.sentence-wait-mark {
  position: relative;
  width: 108rpx;
  height: 86rpx;
  margin: 0 auto 24rpx;
}

.sentence-wait-page {
  position: absolute;
  width: 66rpx;
  height: 76rpx;
  border: 1rpx solid rgba(24, 25, 30, 0.08);
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(24, 25, 30, 0.08);
}

.sentence-wait-page::before,
.sentence-wait-page::after {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(24, 25, 30, 0.12);
  content: "";
}

.sentence-wait-page::before {
  top: 24rpx;
}

.sentence-wait-page::after {
  top: 40rpx;
}

.page-one {
  left: 6rpx;
  top: 6rpx;
  transform: rotate(-8deg);
  animation: sentence-page-left 2.2s ease-in-out infinite;
}

.page-two {
  right: 6rpx;
  top: 0;
  transform: rotate(9deg);
  animation: sentence-page-right 2.2s ease-in-out infinite;
}

.sentence-wait-dot {
  position: absolute;
  right: 12rpx;
  bottom: 4rpx;
  width: 24rpx;
  height: 24rpx;
  border: 5rpx solid #17181d;
  border-radius: 999rpx;
  background: #f5aa24;
  box-shadow: 0 0 0 8rpx rgba(245, 170, 36, 0.16);
}

.sentence-wait-kicker,
.sentence-wait-title,
.sentence-wait-copy {
  display: block;
  text-align: center;
}

.sentence-wait-kicker {
  color: #d48310;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 1;
}

.sentence-wait-title {
  margin-top: 14rpx;
  color: #202126;
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1.2;
}

.sentence-wait-copy {
  max-width: 520rpx;
  margin: 15rpx auto 0;
  color: #737a82;
  font-size: 24rpx;
  font-weight: 780;
  line-height: 1.48;
}

.sentence-wait-rail {
  position: relative;
  height: 9rpx;
  overflow: hidden;
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: rgba(24, 25, 30, 0.08);
}

.sentence-wait-rail-fill {
  position: absolute;
  top: 0;
  left: -38%;
  width: 38%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #17181d, #f5aa24);
  animation: sentence-rail-run 1.82s ease-in-out infinite;
}

.sentence-wait-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
}

.sentence-wait-chips text {
  display: flex;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  border: 1rpx solid rgba(24, 25, 30, 0.06);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #69717b;
  font-size: 21rpx;
  font-weight: 950;
  line-height: 1;
}

@keyframes modal-mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes modal-card-in {
  from {
    opacity: 0;
    transform: translateY(24rpx) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes sentence-page-left {
  0%,
  100% {
    transform: translateY(0) rotate(-8deg);
  }

  50% {
    transform: translateY(-7rpx) rotate(-4deg);
  }
}

@keyframes sentence-page-right {
  0%,
  100% {
    transform: translateY(0) rotate(9deg);
  }

  50% {
    transform: translateY(7rpx) rotate(5deg);
  }
}

@keyframes sentence-rail-run {
  0% {
    left: -38%;
  }

  52% {
    left: 42%;
  }

  100% {
    left: 100%;
  }
}

.empty-card {
  display: flex;
  min-height: 360rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 34rpx;
  border: 2rpx dashed #d9dce2;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.72);
}

.empty-title {
  color: #202126;
  font-size: 27rpx;
  font-weight: 900;
}

.empty-copy {
  color: #969aa5;
  font-size: 22rpx;
  font-weight: 700;
}

.clock-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  border: 5rpx solid currentColor;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.clock-icon::before {
  position: absolute;
  top: 7rpx;
  left: 13rpx;
  width: 4rpx;
  height: 11rpx;
  border-radius: 999rpx;
  background: currentColor;
  content: "";
}

.clock-icon::after {
  position: absolute;
  top: 15rpx;
  left: 13rpx;
  width: 12rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
  content: "";
}

.camera-mini {
  position: relative;
  width: 38rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.camera-mini::before {
  position: absolute;
  top: -11rpx;
  left: 11rpx;
  width: 16rpx;
  height: 8rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 7rpx 7rpx 0 0;
  box-sizing: border-box;
  content: "";
}

.camera-mini::after {
  position: absolute;
  top: 6rpx;
  left: 11rpx;
  width: 10rpx;
  height: 10rpx;
  border: 4rpx solid currentColor;
  border-radius: 999rpx;
  content: "";
}
