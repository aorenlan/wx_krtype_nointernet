<view class="page">

  <!-- 模糊背景层：用当前单词图片虚化 -->
  <view class="bg-blur" wx:if="{{word && word.image}}">
    <image class="bg-img" src="{{word.image}}" mode="aspectFill"></image>
    <view class="bg-mask"></view>
  </view>

  <!-- 状态栏 + 胶囊占位 -->
  <view class="status-bar" style="height: {{navTotalHeight}}px;"></view>

  <!-- 顶部标题栏 -->
  <view class="topbar">
    <view class="title-pill">
      <view class="dot"></view>
      <text>看图想韩语</text>
    </view>
    <view class="count-pill">{{total ? (current + 1 < 10 ? '0' + (current + 1) : (current + 1)) : '00'}} / {{total < 10 ? '0' + total : total}}</view>
  </view>

  <!-- 模式切换 -->
  <view class="mode-row">
    <view class="mode-switch {{autoMode ? 'on' : ''}}" bindtap="toggleMode">
      <text class="mode-label">{{autoMode ? '自动播放' : '手动输入'}}</text>
      <view class="mode-knob"></view>
    </view>
  </view>

  <view wx:if="{{contentLoading}}" class="content-state">加载中</view>
  <view wx:elif="{{!word}}" class="content-state">暂无单词</view>

  <!-- 学习态：完成后也保持显示，避免卡片被替换成空白/完成页 -->
  <view class="study-stack" wx:if="{{word && !contentLoading}}">
    <!-- 图片卡：答案面板作为内部常驻子节点，避免揭晓卡被兄弟布局吞掉 -->
    <view class="image-card">
      <view wx:if="{{!groupDone && phase === 'asking' && !autoContinuePending}}" class="corner-control" catchtap="openCategorySheet">
        <text class="corner-label">分类</text>
        <text class="corner-name">{{groupTitle}}</text>
        <text class="corner-arrow">⌄</text>
      </view>
      <view wx:if="{{!groupDone && autoMode && !autoPaused && (phase === 'countdown' || phase === 'reveal' || autoContinuePending)}}" class="corner-control" catchtap="pauseAutoPlay">暂停</view>

      <view class="image-frame" bindtap="onCardTap">
        <image class="pic" src="{{word.image}}" mode="aspectFit" lazy-load="true"></image>

        <!-- 右上角徽标：asking 显示 ?，countdown 显示数字 -->
        <view wx:if="{{showAskBadge}}" class="badge ask">?</view>
        <view wx:if="{{showCountBadge}}" class="badge count">
          <view class="ring" style="background: conic-gradient(#e8a04a {{countdownPercent}}%, #ffffff 0);"></view>
          <text class="count-num">{{countdown}}</text>
        </view>

        <!-- 底部提问气泡（reveal 前显示） -->
        <view wx:if="{{showAskBubble}}" class="ask-bubble">{{questionText}}</view>
      </view>

      <!-- 单词卡片：常驻固定高度，只更新文字内容 -->
      <view class="{{answerPanelClass}}">
        <view class="read-tip {{readTipText && !readDone && !groupDone ? '' : 'is-placeholder'}}">{{readTipText || '朗读提示'}}</view>
        <view class="answer-ko {{cardKoreanClass}}">{{cardKoreanText}}</view>
        <view class="answer-meta {{cardMetaClass}}">{{cardMetaText}}</view>

        <view class="read-progress">
          <view class="dots">
            <view class="d {{koReadIndex >= 1 ? 'active' : ''}}"></view>
            <view class="d {{koReadIndex >= 2 ? 'active' : ''}}"></view>
            <view class="d {{koReadIndex >= 3 ? 'active' : ''}}"></view>
          </view>
          <view class="stage-chip {{readType === 'en' ? 'active' : ''}}">英文</view>
        </view>

        <view class="answer-en {{readType === 'en' ? 'hl' : ''}} {{cardEnglishClass}}">{{cardEnglishText}}</view>

        <view class="reveal-actions">
          <view wx:if="{{!groupDone && showRetryButton}}" class="ghost-btn warn" catchtap="retryCurrentRead">重试朗读</view>
          <view wx:if="{{!groupDone && showNextButton}}" class="ghost-btn" catchtap="goNext">{{nextButtonText}}</view>
          <view wx:if="{{groupDone}}" class="ghost-btn" catchtap="restart">再来一组</view>
        </view>
      </view>
    </view>

    <!-- 手动输入区（手动模式 + 非揭晓时） -->
    <view wx:if="{{!groupDone && !autoMode && phase !== 'reveal'}}" class="manual-box">
      <input class="kr-input {{inputError ? 'err' : ''}}" value="{{inputValue}}" bindinput="onInput" placeholder="输入韩文原词" confirm-type="done" bindconfirm="submitInput" />
      <button class="primary-btn" bindtap="submitInput">确认</button>
      <view class="hint">看图打出对应的韩文，正确进入下一个</view>
    </view>

    <!-- 底部操作：开始播放 -->
    <view wx:if="{{!groupDone && (phase === 'asking' || autoPaused) && !autoContinuePending}}" class="study-actions">
      <button wx:if="{{autoMode || autoPaused}}" class="primary-btn start-btn" bindtap="startSequence">{{autoPaused ? '▶ 继续播放' : '▶ 开始播放'}}</button>
    </view>
  </view>

  <view wx:if="{{categoryPanelVisible}}" class="category-mask" catchtap="closeCategoryPanel">
    <view class="category-sheet" catchtap="preventBubble">
      <view class="sheet-grabber"></view>
      <view class="category-head">
        <view>
          <view class="category-title">切换分类</view>
          <view class="category-sub">每天首次切换看一次广告，今日解锁后可自由切换</view>
        </view>
        <view class="category-close" catchtap="closeCategoryPanel">×</view>
      </view>

      <view class="category-order-card">
        <view class="category-order-main">
          <view class="category-order-title">播放顺序</view>
          <view class="category-order-sub">{{shuffleEnabled ? '随机播放，会记住本轮打乱后的顺序' : '按上传顺序播放'}}</view>
        </view>
        <view class="order-segment">
          <view class="order-segment-item {{!shuffleEnabled ? 'active' : ''}}" data-shuffle="0" catchtap="setShuffleMode">顺序</view>
          <view class="order-segment-item {{shuffleEnabled ? 'active' : ''}}" data-shuffle="1" catchtap="setShuffleMode">随机</view>
        </view>
        <view wx:if="{{shuffleEnabled}}" class="reshuffle-btn" catchtap="reshuffleCurrentGroup">重新打乱</view>
      </view>

      <view class="category-search">
        <text class="category-search-label">搜索</text>
        <input class="category-search-input" value="{{categorySearchText}}" bindinput="onCategorySearchInput" placeholder="输入分类名" confirm-type="search" />
        <view wx:if="{{categorySearchText}}" class="category-search-clear" catchtap="clearCategorySearch">清空</view>
      </view>

      <scroll-view class="category-scroll" scroll-y="true" enhanced="{{true}}" show-scrollbar="{{false}}" bounces="{{true}}">
        <view wx:if="{{!categoryList.length}}" class="category-empty">没有匹配的分类</view>
        <view wx:for="{{categoryList}}" wx:key="id" class="category-item {{item.active ? 'active' : ''}}" data-group-id="{{item.id}}" catchtap="selectCategory">
          <view class="category-item-main">
            <view class="category-item-name">{{item.name}}</view>
            <view class="category-item-meta">{{item.metaText}}</view>
          </view>
          <view class="category-item-state">{{item.stateText}}</view>
        </view>
        <view class="category-uploading">
          <view class="category-uploading-mark"></view>
          <view class="category-uploading-main">
            <view class="category-uploading-title">更多分类持续上传中</view>
            <view class="category-uploading-sub">新图片词卡会陆续同步到这里</view>
          </view>
          <view class="category-uploading-tag">更新中</view>
        </view>
      </scroll-view>
    </view>
  </view>

</view>
