page {
  background:
    radial-gradient(circle at 18% 8%, rgba(214, 232, 221, 0.95) 0, rgba(214, 232, 221, 0) 36%),
    radial-gradient(circle at 84% 24%, rgba(244, 198, 151, 0.8) 0, rgba(244, 198, 151, 0) 38%),
    linear-gradient(180deg, #eef5ef 0%, #f1dfc7 100%);
  color: #17303a;
}

.page {
  min-height: 100vh;
  padding: 0 18rpx 176rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

/* 模糊背景层 */
.bg-blur {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  overflow: hidden;
}
.bg-img {
  position: absolute;
  top: -60rpx; left: -60rpx;
  width: calc(100% + 120rpx);
  height: calc(100% + 120rpx);
  filter: blur(40rpx);
  transform: scale(1.2);
}
.bg-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background:
    linear-gradient(180deg, rgba(238,245,239,0.78) 0%, rgba(241,223,199,0.9) 100%),
    radial-gradient(circle at 50% 72%, rgba(23,48,58,0.08), rgba(23,48,58,0) 34%);
}

/* 顶部栏 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.title-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255,255,255,0.68);
  border: 1rpx solid rgba(255,255,255,0.78);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  font-weight: 800;
  font-size: 26rpx;
  color: #17303a;
  box-shadow: 0 10rpx 26rpx rgba(65,80,66,0.08);
}
.title-pill .dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #f3af36;
  box-shadow: 0 0 0 8rpx rgba(243,175,54,0.14);
}
.top-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.share-pill {
  position: relative;
  display: flex;
  min-width: 118rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 20% 18%, rgba(255,255,255,0.54), transparent 30%),
    linear-gradient(135deg, #17303a 0%, #31534c 58%, #e9a936 100%);
  color: #fff;
  box-shadow:
    0 12rpx 28rpx rgba(21,44,55,0.18),
    inset 0 1rpx 0 rgba(255,255,255,0.34);
}
.share-pill::after { border: none; }
.share-glow {
  position: absolute;
  top: -36rpx;
  right: -20rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 246, 226, 0.42);
}
.share-pill-press { transform: scale(0.96); opacity: 0.9; }
.share-icon {
  position: relative;
  z-index: 1;
  width: 26rpx;
  height: 26rpx;
  filter: brightness(0) invert(1);
}
.share-label {
  position: relative;
  z-index: 1;
  color: #fff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1;
}
.count-pill {
  background: rgba(21, 44, 55, 0.9);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-weight: 800;
  font-size: 24rpx;
  color: #fff8e9;
  font-variant-numeric: tabular-nums;
  box-shadow: 0 10rpx 24rpx rgba(21,44,55,0.16);
}
.share-canvas {
  position: absolute;
  left: -9999px;
  top: 0;
  width: 500px;
  height: 400px;
  opacity: 0;
  pointer-events: none;
}

/* 模式切换 */
.mode-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin: 14rpx 2rpx 0;
}
.mode-switch {
  flex: none;
  margin-left: auto;
  display: flex; align-items: center; gap: 12rpx;
  background: rgba(255,255,255,0.42);
  border: 1rpx solid rgba(255,255,255,0.62);
  border-radius: 999rpx;
  padding: 8rpx 12rpx 8rpx 20rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.66);
}
.mode-switch:active { transform: scale(0.98); }
.mode-switch.on { background: rgba(255,246,226,0.68); }
.mode-label { font-size: 23rpx; color: #5b6b61; font-weight: 700; }
.mode-knob {
  width: 32rpx; height: 32rpx; border-radius: 50%;
  background: #97aaa0;
}
.mode-switch.on .mode-knob { background: #f3af36; }

.content-state {
  margin-top: 24rpx;
  padding: 80rpx 24rpx;
  border-radius: 34rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #6f7f74;
  background: rgba(255,255,255,0.5);
  border: 1rpx solid rgba(255,255,255,0.66);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.7);
}

.study-stack {
  margin-top: 20rpx;
  padding: 10rpx;
  border-radius: 42rpx;
  background: rgba(255,255,255,0.24);
  border: 1rpx solid rgba(255,255,255,0.62);
  box-shadow:
    0 34rpx 90rpx rgba(49,70,54,0.13),
    inset 0 1rpx 0 rgba(255,255,255,0.66);
}

/* 图片卡 */
.image-card {
  position: relative;
  margin-top: 0;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.94), rgba(255,250,240,0.9));
  border-radius: 36rpx;
  padding: 10rpx;
  box-shadow:
    0 22rpx 52rpx rgba(54,64,47,0.14),
    inset 0 1rpx 0 rgba(255,255,255,0.82);
  overflow: hidden;
}
.image-card:active { transform: scale(0.995); }
.corner-control {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 12;
  max-width: 260rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: rgba(23,48,58,0.58);
  color: rgba(255,255,255,0.86);
  font-size: 21rpx;
  line-height: 1;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 8rpx 18rpx rgba(23,48,58,0.12);
  box-sizing: border-box;
}
.corner-control:active { transform: scale(0.96); }
.corner-label {
  flex: none;
  color: rgba(255,255,255,0.76);
}
.corner-name {
  min-width: 0;
  flex: 1;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.corner-arrow {
  flex: none;
  margin-top: -6rpx;
  color: rgba(255,255,255,0.68);
  font-size: 26rpx;
  font-weight: 900;
}
.image-frame {
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #dff3f4 0%, #fffaf2 100%);
}
.pic {
  width: 100%;
  height: 600rpx;
  border-radius: 28rpx;
  display: block;
  background: transparent;
}

/* 右上角徽标 */
.badge {
  position: absolute;
  top: 28rpx; right: 28rpx;
  width: 82rpx; height: 82rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(22,35,42,0.92);
  color: #fff;
  font-size: 42rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 26rpx rgba(20,32,38,0.26);
  border: 5rpx solid rgba(255,255,255,0.92);
}
.badge.count { background: transparent; border: none; box-shadow: none; }
.badge.count .ring {
  position: absolute;
  width: 82rpx; height: 82rpx; border-radius: 50%;
}
.badge.count .ring::after {
  content: '';
  position: absolute;
  top: 7rpx; left: 7rpx; right: 7rpx; bottom: 7rpx;
  border-radius: 50%;
  background: #17303a;
}
.badge.count .count-num {
  position: relative; z-index: 2;
  color: #fff; font-size: 42rpx; font-weight: 800;
}

/* 提问气泡 */
.ask-bubble {
  position: absolute;
  left: 28rpx; bottom: 28rpx;
  background: rgba(23,48,58,0.82);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  padding: 14rpx 24rpx;
  border-radius: 18rpx;
  box-shadow: 0 12rpx 26rpx rgba(23,48,58,0.18);
}

.answer-panel {
  margin: 16rpx 10rpx 4rpx;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.98), rgba(255,252,246,0.96));
  border-radius: 30rpx;
  padding: 22rpx 26rpx 24rpx;
  text-align: center;
  box-shadow:
    0 16rpx 40rpx rgba(44,59,47,0.12),
    inset 0 1rpx 0 rgba(255,255,255,0.92);
  overflow: hidden;
  opacity: 1;
  min-height: 286rpx;
  box-sizing: border-box;
  transition: opacity .18s ease, min-height .18s ease, margin .18s ease, padding .18s ease;
}
.answer-panel.is-hidden {
  height: 0;
  min-height: 0;
  margin: 0 10rpx;
  padding-top: 0;
  padding-bottom: 0;
  opacity: 0;
  pointer-events: none;
  box-shadow: none;
}
.answer-panel.is-visible {
  opacity: 1;
}
.read-tip {
  color: #c58b24;
  font-weight: 800;
  font-size: 24rpx;
  height: 32rpx;
  line-height: 32rpx;
  margin-bottom: 6rpx;
  overflow: hidden;
  transition: opacity .16s ease;
}
.read-tip.is-placeholder {
  opacity: 0;
}
.answer-ko {
  font-size: 70rpx;
  font-weight: 900;
  color: #e9a936;
  line-height: 1.1;
  word-break: break-word;
  text-shadow: 0 4rpx 0 rgba(140,92,14,0.06);
}
.answer-ko.compact { font-size: 60rpx; line-height: 1.08; }
.answer-ko.tiny { font-size: 52rpx; line-height: 1.08; }
.answer-meta {
  font-size: 30rpx;
  font-weight: 800;
  color: #17303a;
  margin-top: 6rpx;
  line-height: 1.24;
  overflow-wrap: anywhere;
  word-break: break-word;
}
.answer-meta.compact { font-size: 27rpx; }
.answer-meta.tiny { font-size: 24rpx; }
.read-progress {
  min-height: 42rpx;
  margin: 16rpx 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.dots {
  display: flex; justify-content: center; gap: 14rpx;
}
.dots .d {
  width: 50rpx; height: 12rpx; border-radius: 999rpx;
  background: #d7ded4;
  transition: background .2s;
}
.dots .d.active { background: #f0af2f; }
.stage-chip {
  min-width: 56rpx;
  height: 30rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #edf2ed;
  color: #9aa59d;
  font-size: 20rpx;
  font-weight: 900;
  box-sizing: border-box;
}
.stage-chip.active {
  background: #17303a;
  color: #fff8e9;
}
.answer-en {
  font-size: 34rpx;
  font-weight: 800;
  color: #b6bdb7;
  letter-spacing: 0;
  min-height: 42rpx;
  line-height: 1.18;
  overflow-wrap: anywhere;
  word-break: break-word;
}
.answer-en.compact { font-size: 30rpx; }
.answer-en.tiny { font-size: 27rpx; }
.answer-en.hl { color: #17303a; }

.reveal-actions {
  display: flex; justify-content: center; gap: 24rpx;
  margin-top: 16rpx;
  min-height: 58rpx;
}
.ghost-btn {
  background: #eef4ee;
  color: #365247;
  font-size: 26rpx;
  font-weight: 800;
  padding: 14rpx 30rpx;
  border-radius: 18rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.76);
}
.ghost-btn.warn {
  color: #7a3f18;
  background: #fff0dc;
}
.ghost-btn:active { transform: scale(0.97); }

/* 手动输入 */
.manual-box {
  margin-top: 36rpx;
  display: flex; flex-direction: column; gap: 20rpx;
}
.kr-input {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  font-size: 40rpx;
  text-align: center;
  border: 3rpx solid transparent;
}
.kr-input.err { border-color: #e76f6f; }
.hint { text-align: center; color: #9a8e76; font-size: 24rpx; }

.auto-hint {
  margin-top: 22rpx;
  display: flex;
  justify-content: center;
}

.study-actions {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.study-actions .start-btn {
  flex: 1;
  width: auto;
  min-width: 0;
}

.primary-btn {
  width: 100%;
  margin: 0;
  background: linear-gradient(135deg, #f4b13b 0%, #e99635 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  border-radius: 999rpx;
  padding: 20rpx 0;
  border: none;
  box-shadow: 0 18rpx 38rpx rgba(219,136,36,0.28);
}
.primary-btn:active { transform: scale(0.985); }
.primary-btn::after { border: none; }

.pw-dialog-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10120;
  padding: 44rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(19, 20, 24, 0.48);
  backdrop-filter: blur(18rpx);
}

.pw-dialog {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  padding: 54rpx 42rpx 34rpx;
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background:
    radial-gradient(circle at 92% 0%, rgba(246, 179, 90, 0.16), transparent 36%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 248, 249, 0.94));
  box-shadow: 0 28rpx 84rpx rgba(0, 0, 0, 0.28);
  box-sizing: border-box;
  animation: pw-dialog-in 160ms ease-out both;
}

.pw-dialog.resume {
  padding-top: 48rpx;
}

@keyframes pw-dialog-in {
  from {
    opacity: 0;
    transform: translateY(18rpx) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.pw-dialog-mark {
  width: 78rpx;
  height: 78rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: #17181d;
  box-shadow: 0 16rpx 34rpx rgba(24, 25, 30, 0.20);
  position: relative;
}

.pw-dialog-mark.small {
  width: 68rpx;
  height: 68rpx;
}

.pw-dialog-ring {
  position: absolute;
  left: 20rpx;
  top: 18rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 5rpx solid #f5f6f4;
  border-right-color: transparent;
  transform: rotate(-18deg);
}

.pw-dialog-mark.small .pw-dialog-ring {
  left: 17rpx;
  top: 16rpx;
  width: 28rpx;
  height: 28rpx;
}

.pw-dialog-dot {
  position: absolute;
  right: 14rpx;
  bottom: 12rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #f3ad32;
  box-shadow: 0 0 0 7rpx rgba(243, 173, 50, 0.18);
}

.pw-dialog-title {
  text-align: center;
  color: #202126;
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1.25;
}

.pw-dialog-copy {
  margin-top: 18rpx;
  text-align: center;
  color: #73777f;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.55;
}

.pw-dialog-note {
  width: 340rpx;
  margin: 24rpx auto 0;
  min-height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(240, 241, 242, 0.92);
  color: #5f666b;
  font-size: 22rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
}

.pw-dialog-note-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #f3ad32;
  box-shadow: 0 0 0 6rpx rgba(243, 173, 50, 0.14);
}

.pw-resume-progress {
  margin-top: 24rpx;
  height: 76rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  background: rgba(240, 241, 242, 0.86);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  color: #7b8087;
  font-size: 23rpx;
  font-weight: 900;
}

.pw-resume-progress view {
  min-width: 96rpx;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #17181d;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.pw-dialog-actions {
  margin-top: 30rpx;
  display: flex;
  gap: 16rpx;
}

.pw-dialog-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 950;
  box-sizing: border-box;
}

.pw-dialog-btn:active {
  transform: scale(0.98);
}

.pw-dialog-btn.secondary {
  background: #f0f1f2;
  color: #5f666b;
}

.pw-dialog-btn.primary {
  background: #17181d;
  color: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(24, 25, 30, 0.16);
}

.pw-dialog-btn.primary.is-loading {
  opacity: 0.72;
}

.pw-dialog-btn.primary.is-loading::before {
  content: '';
  width: 18rpx;
  height: 18rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.52);
  border-top-color: #ffffff;
  animation: pw-spin 780ms linear infinite;
}

@keyframes pw-spin {
  to { transform: rotate(360deg); }
}

.category-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10020;
  display: flex;
  align-items: flex-end;
  background: rgba(24, 25, 30, 0.42);
  backdrop-filter: blur(18rpx);
}
.category-sheet {
  width: 100%;
  max-height: 84vh;
  padding: 14rpx 30rpx calc(44rpx + env(safe-area-inset-bottom));
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  border-bottom: 0;
  border-radius: 38rpx 38rpx 0 0;
  background:
    radial-gradient(circle at 90% 0%, rgba(246, 179, 90, 0.12), transparent 32%),
    rgba(248, 248, 249, 0.98);
  box-shadow: 0 -28rpx 80rpx rgba(24, 25, 30, 0.22);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  animation: category-sheet-in 180ms ease-out both;
}
@keyframes category-sheet-in {
  from {
    opacity: 0;
    transform: translateY(26rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.sheet-grabber {
  width: 76rpx;
  height: 8rpx;
  border-radius: 999rpx;
  margin: 0 auto 22rpx;
  background: #d9ddd8;
}
.category-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.category-title {
  font-size: 36rpx;
  font-weight: 950;
  color: #202126;
  line-height: 1.2;
}
.category-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  font-weight: 800;
  color: #868a91;
}
.category-close {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef0ef;
  color: #59635f;
  font-size: 38rpx;
  line-height: 1;
  font-weight: 900;
}
.category-close:active { transform: scale(0.96); }
.category-practice-card {
  margin-top: 22rpx;
  min-height: 96rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(24, 25, 30, 0.05);
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 95% 0%, rgba(246, 179, 90, 0.14), transparent 42%),
    rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 40rpx rgba(24, 25, 30, 0.07);
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
}
.category-practice-card:active {
  transform: scale(0.986);
  opacity: 0.92;
}
.category-practice-icon {
  flex: none;
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: #17181d;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 950;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 26rpx rgba(24, 25, 30, 0.16);
}
.category-practice-copy {
  flex: 1;
  min-width: 0;
}
.category-practice-title {
  color: #202126;
  font-size: 28rpx;
  font-weight: 950;
  line-height: 1.18;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.category-practice-sub {
  margin-top: 6rpx;
  color: #8b8f96;
  font-size: 21rpx;
