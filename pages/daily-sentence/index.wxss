.page {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #0f1117;
  color: #202126;
}

.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  background: #0f1117;
}

.loading-spinner {
  width: 32px;
  height: 32px;
  border: 3px solid rgba(255, 255, 255, 0.12);
  border-top-color: #f5aa24;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 14px;
  color: #c9ccd4;
  font-weight: 700;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.stage {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  background: #0f1117;
}

.bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 52%;
  z-index: 0;
  opacity: 0.98;
  filter: saturate(1.06) contrast(0.98);
}

.stage::before {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  content: "";
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(7, 10, 18, 0.18) 0%, rgba(7, 10, 18, 0.05) 34%, rgba(15, 17, 23, 0.76) 56%, #0f1117 100%),
    linear-gradient(90deg, rgba(7, 10, 18, 0.34), transparent 40%, rgba(7, 10, 18, 0.18));
}

.cn-top {
  position: absolute;
  top: 18px;
  left: 22px;
  right: 22px;
  z-index: 8;
  display: flex;
  justify-content: flex-end;
  pointer-events: none;
}

.cn-badge {
  display: none;
}

.auto-wrap {
  display: flex;
  pointer-events: auto;
}

.auto-btn {
  position: relative;
  width: 40px;
  height: 40px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.42);
  box-shadow: 0 14px 36px rgba(7, 10, 18, 0.2);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.auto-btn.on {
  background: rgba(23, 24, 29, 0.86);
  border-color: rgba(255, 255, 255, 0.16);
}

.auto-btn.on .auto-icon {
  filter: brightness(0) invert(1);
}

.auto-btn:active {
  transform: scale(0.96);
}

.auto-icon {
  width: 18px;
  height: 18px;
  opacity: 0.94;
}

.auto-slash {
  position: absolute;
  width: 23px;
  height: 2px;
  border-radius: 2px;
  background: rgba(239, 68, 68, 0.92);
  transform: rotate(-28deg);
}

.hero-copy {
  position: absolute;
  left: 22px;
  right: 22px;
  top: 52px;
  z-index: 5;
  color: #ffffff;
  pointer-events: none;
}

.hero-kicker {
  display: inline-flex;
  max-width: 74%;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.17);
  border: 1px solid rgba(255, 255, 255, 0.24);
  color: rgba(255, 255, 255, 0.9);
  font-size: 11px;
  font-weight: 900;
  line-height: 1.1;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.hero-source {
  display: block;
  max-width: 84%;
  max-height: 74px;
  margin-top: 12px;
  overflow: hidden;
  color: #ffffff;
  font-size: 28px;
  font-weight: 900;
  line-height: 1.18;
  text-shadow: 0 14px 34px rgba(7, 10, 18, 0.38);
}

.hero-context {
  display: block;
  max-width: 82%;
  max-height: 42px;
  margin-top: 8px;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.82);
  font-size: 13px;
  font-weight: 800;
  line-height: 1.55;
  text-shadow: 0 10px 28px rgba(7, 10, 18, 0.34);
}

.card-stage {
  position: absolute;
  left: 0;
  right: 0;
  top: 39%;
  bottom: calc(86px + env(safe-area-inset-bottom, 0px));
  z-index: 6;
  box-sizing: border-box;
  padding: 0 16px;
}

.card {
  position: absolute;
  top: 0;
  left: 16px;
  right: 16px;
  bottom: 0;
  width: auto;
  max-width: 390px;
  min-width: 0;
  min-height: 0;
  margin: 0 auto;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 16px 16px 14px;
  border-radius: 28px;
  color: #202126;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.78), rgba(244, 246, 245, 0.58));
  border: 1px solid rgba(255, 255, 255, 0.66);
  box-shadow:
    0 24px 62px rgba(0, 0, 0, 0.28),
    inset 0 1px 0 rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(22px) saturate(1.12);
  -webkit-backdrop-filter: blur(22px) saturate(1.12);
  will-change: transform, opacity;
  backface-visibility: hidden;
}

.card.current {
  z-index: 7;
  transform: translateY(0) scale(1);
  opacity: 1;
}

.card.next {
  z-index: 6;
  transform: translateY(18px) scale(0.965);
  opacity: 0.56;
  filter: saturate(0.9) blur(1px);
}

.card.current.anim-out-next {
  animation: cardOutNext 240ms cubic-bezier(0.22, 0.72, 0.18, 1) forwards;
}

.card.current.anim-out-prev {
  animation: cardOutPrev 240ms cubic-bezier(0.22, 0.72, 0.18, 1) forwards;
}

.card.next.anim-in-next {
  z-index: 9;
  animation: cardInFromNext 240ms cubic-bezier(0.22, 0.72, 0.18, 1) forwards;
}

.card.next.anim-in-prev {
  z-index: 9;
  animation: cardInFromPrev 240ms cubic-bezier(0.22, 0.72, 0.18, 1) forwards;
}

@keyframes cardOutNext {
  from {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  to {
    transform: translateY(-30px) scale(0.985);
    opacity: 0;
  }
}

@keyframes cardOutPrev {
  from {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  to {
    transform: translateY(30px) scale(0.985);
    opacity: 0;
  }
}

@keyframes cardInFromNext {
  from {
    transform: translateY(18px) scale(0.965);
    opacity: 0.56;
  }
  to {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}

@keyframes cardInFromPrev {
  from {
    transform: translateY(-18px) scale(0.965);
    opacity: 0.56;
  }
  to {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}

.card-top {
  min-height: 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex: 0 0 auto;
}

.tone-pill {
  max-width: 72%;
  padding: 7px 11px;
  border-radius: 999px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  background: #17181d;
  color: #ffffff;
  font-size: 11px;
  font-weight: 900;
}

.audio-btn {
  width: 40px;
  height: 40px;
  border-radius: 999px;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.44);
  border: 1px solid rgba(255, 255, 255, 0.56);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.62),
    0 10px 26px rgba(7, 10, 18, 0.08);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.audio-btn:active {
  transform: scale(0.96);
}

.audio-icon {
  width: 18px;
  height: 18px;
  opacity: 0.9;
}

.kr-wrap {
  margin-top: 8px;
  flex: 0 0 auto;
}

.kr-text {
  display: block;
  color: #202126;
  font-size: 28px;
  font-weight: 900;
  line-height: 1.18;
  letter-spacing: 0;
  white-space: pre-wrap;
  word-break: break-word;
}

.romaji {
  display: block;
  margin-top: 6px;
  color: rgba(31, 35, 45, 0.48);
  font-size: 13px;
  font-weight: 900;
  line-height: 1.2;
}

.card-body {
  flex: 1;
  min-height: 0;
  margin-top: 13px;
}

.desc {
  margin-bottom: 10px;
  padding: 11px 12px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.48);
  border: 1px solid rgba(255, 255, 255, 0.52);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.72),
    0 8px 18px rgba(7, 10, 18, 0.05);
}

.desc-title {
  display: block;
  margin-bottom: 5px;
  color: rgba(31, 35, 45, 0.44);
  font-size: 11px;
  font-weight: 900;
  line-height: 1.2;
}

.desc-text {
  display: block;
  color: #202126;
  font-size: 13px;
  font-weight: 800;
  line-height: 1.55;
}

.floating-controls {
  position: fixed;
  left: 18px;
  right: 18px;
  bottom: calc(14px + env(safe-area-inset-bottom, 0px));
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.next-fab {
  width: 100%;
  max-width: 390px;
  height: 52px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #17181d;
  font-size: 16px;
  font-weight: 900;
  box-shadow:
    0 18px 46px rgba(0, 0, 0, 0.32),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

.next-fab:active {
  transform: scale(0.985);
  opacity: 0.92;
}

@media (max-height: 700px) {
  .bg {
    height: 48%;
  }

  .hero-copy {
    top: 44px;
  }

  .hero-source {
    max-width: 78%;
    max-height: 58px;
    font-size: 23px;
  }

  .hero-context {
    display: none;
  }

  .card-stage {
    top: 37%;
    bottom: calc(78px + env(safe-area-inset-bottom, 0px));
  }

  .card {
    padding: 13px 13px 12px;
    border-radius: 24px;
  }

  .card-top {
    min-height: 34px;
  }

  .tone-pill {
    padding: 6px 10px;
  }

  .audio-btn {
    width: 34px;
    height: 34px;
  }

  .kr-text {
    font-size: 24px;
  }

  .romaji {
    font-size: 12px;
  }

  .desc {
    padding: 9px 10px;
    margin-bottom: 8px;
    border-radius: 16px;
  }

  .desc-text {
    font-size: 12px;
    line-height: 1.48;
  }

  .next-fab {
    height: 46px;
    font-size: 15px;
  }
}
