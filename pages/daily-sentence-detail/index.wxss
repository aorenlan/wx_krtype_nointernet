.page {
  height: 100vh;
  height: 100dvh;
  display: flex;
  flex-direction: column;
  background: #0b1220;
  overflow: hidden;
}

.swipe-progress { color: rgba(255,255,255,.58); font-size: 11px; font-weight: 800; letter-spacing: .12em; }
.next-fab-arrow { margin-left: 8px; color: #f5aa24; font-size: 18px; line-height: 1; }
.swipe-guide { position: fixed; left: 50%; bottom: calc(94px + env(safe-area-inset-bottom, 0px)); z-index: 1200; width: 250px; max-width: calc(100vw - 44px); padding: 12px 18px 13px; border: 1px solid rgba(255,255,255,.22); border-radius: 18px; box-sizing: border-box; transform: translateX(-50%); background: rgba(20,22,28,.9); box-shadow: 0 18px 48px rgba(0,0,0,.3); color: #fff; text-align: center; pointer-events: none; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); animation: swipeGuideIn 260ms ease-out both; }
.swipe-guide::after { position: absolute; left: 50%; bottom: -6px; width: 12px; height: 12px; content: ""; transform: translateX(-50%) rotate(45deg); background: rgba(20,22,28,.9); }
.swipe-guide-arrows { display: flex; justify-content: center; gap: 10px; color: #f5aa24; font-size: 17px; font-weight: 900; }
.swipe-guide-title, .swipe-guide-copy { display: block; }
.swipe-guide-title { margin-top: 3px; font-size: 14px; font-weight: 900; }
.swipe-guide-copy { margin-top: 2px; color: rgba(255,255,255,.65); font-size: 11px; font-weight: 700; }
@keyframes swipeGuideIn { from { transform: translate(-50%, 10px); opacity: 0; } to { transform: translate(-50%, 0); opacity: 1; } }
.next-sentence-mask { position: fixed; inset: 0; z-index: 5000; display: flex; align-items: flex-end; background: rgba(4,6,11,.62); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); animation: nextMaskIn 180ms ease-out both; }
.next-sentence-sheet { width: 100%; padding: 12px 22px calc(18px + env(safe-area-inset-bottom, 0px)); border-radius: 28px 28px 0 0; box-sizing: border-box; background: #f4f5f4; color: #17181d; animation: nextSheetIn 240ms cubic-bezier(.22,.72,.18,1) both; }
.next-sheet-handle { width: 38px; height: 4px; margin: 0 auto 24px; border-radius: 999px; background: #c5c8c6; }
.next-sheet-eyebrow { display: block; color: #9b6a12; font-size: 12px; font-weight: 900; letter-spacing: .08em; }
.next-sheet-title { display: block; margin-top: 8px; font-size: 27px; font-weight: 900; line-height: 1.2; }
.next-sheet-copy { display: block; margin-top: 10px; color: #666b68; font-size: 15px; line-height: 1.6; }
.next-tip-choice { display: flex; align-items: center; gap: 10px; min-height: 48px; margin-top: 12px; color: #505451; font-size: 14px; font-weight: 700; }
.next-tip-checkbox { width: 21px; height: 21px; border: 2px solid #b8bcb9; border-radius: 7px; display: flex; align-items: center; justify-content: center; box-sizing: border-box; color: #17181d; font-size: 14px; font-weight: 900; }
.next-tip-checkbox.is-checked { border-color: #f5aa24; background: #f5aa24; }
.next-sheet-primary, .next-sheet-secondary { width: 100%; height: 52px; border-radius: 16px; font-size: 15px; font-weight: 900; line-height: 52px; }
.next-sheet-primary { margin-top: 6px; background: #17181d; color: #fff; }
.next-sheet-secondary { margin-top: 8px; background: transparent; color: #747976; }
@keyframes nextMaskIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes nextSheetIn { from { transform: translateY(24px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #0b1220;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
}

.loading-spinner {
  width: 32px;
  height: 32px;
  border: 3px solid rgba(255, 255, 255, 0.1);
  border-top-color: #6366f1;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 14px;
  color: #94a3b8;
  font-weight: 500;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.stage {
  flex: 1;
  position: relative;
  overflow: hidden;
}

.bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.cn-top {
  position: absolute;
  left: 14px;
  right: 14px;
  top: 14px;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.cn-badge {
  padding: 10px 14px;
  border-radius: 14px;
  background: rgba(15, 23, 42, 0.36);
  border: 1px solid rgba(255, 255, 255, 0.22);
  box-shadow: 0 14px 40px rgba(15, 23, 42, 0.24);
  max-width: 74%;
}

.cn-title {
  font-size: 18px;
  font-weight: 900;
  color: rgba(248, 250, 252, 0.96);
  text-shadow: 0 8px 22px rgba(15, 23, 42, 0.35);
  display: block;
  text-align: center;
  white-space: pre-wrap;
  overflow: visible;
}

.auto-wrap {
  position: absolute;
  right: 0;
  top: 0;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0;
  border-radius: 999px;
  background: transparent;
  border: 0;
  box-shadow: none;
  pointer-events: auto;
}

.auto-btn {
  width: 36px;
  height: 36px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.86);
  border: 1px solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 12px 36px rgba(15, 23, 42, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.auto-btn.on {
  background: rgba(99, 102, 241, 0.18);
  border: 1px solid rgba(99, 102, 241, 0.26);
}

.auto-btn:active {
  transform: scale(0.98);
}

.auto-icon {
  width: 18px;
  height: 18px;
  opacity: 0.92;
}

.auto-slash {
  position: absolute;
  width: 22px;
  height: 2px;
  background: rgba(239, 68, 68, 0.9);
  transform: rotate(-28deg);
  border-radius: 2px;
}

.card-stage {
  position: absolute;
  left: 0;
  right: 0;
  top: 86px;
  bottom: 14px;
  z-index: 6;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 0 18px;
  box-sizing: border-box;
}

.floating-controls {
  position: absolute;
  right: 14px;
  bottom: calc(96px + env(safe-area-inset-bottom, 0px));
  z-index: 7;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10px;
}

.next-fab {
  padding: 10px 14px;
  border-radius: 999px;
  background: rgba(99, 102, 241, 0.94);
  color: #ffffff;
  font-size: 12px;
  font-weight: 800;
  box-shadow: 0 14px 40px rgba(15, 23, 42, 0.26);
}

.next-fab:active {
  transform: scale(0.98);
}

.card {
  width: 100%;
  max-width: 380px;
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.975);
  box-shadow: 0 18px 60px rgba(15, 23, 42, 0.26);
  border: 1px solid rgba(15, 23, 42, 0.06);
  padding: 16px 16px 18px;
  box-sizing: border-box;
  position: absolute;
  min-height: 420px;
  max-height: calc(100% - 82px);
  display: flex;
  flex-direction: column;
  min-width: 0;
  will-change: transform, opacity;
  backface-visibility: hidden;
}

.card.next {
  transform: translateY(18px) scale(0.97);
  opacity: 0.82;
  filter: saturate(0.92);
  z-index: 6;
}

.card.current {
  transform: translateY(0) scale(1);
  opacity: 1;
  z-index: 7;
}

.card.current.anim-out-next {
  animation: cardOutNext 240ms cubic-bezier(0.22, 0.72, 0.18, 1) forwards;
}

.card.current.anim-out-prev {
  animation: cardOutPrev 240ms cubic-bezier(0.22, 0.72, 0.18, 1) forwards;
}

.card.next.anim-in-next {
  animation: cardInFromNext 240ms cubic-bezier(0.22, 0.72, 0.18, 1) forwards;
  z-index: 9;
}

.card.next.anim-in-prev {
  animation: cardInFromPrev 240ms cubic-bezier(0.22, 0.72, 0.18, 1) forwards;
  z-index: 9;
}

@keyframes cardOutNext {
  from {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  to {
    transform: translateY(-34px) scale(0.985);
    opacity: 0;
  }
}

@keyframes cardOutPrev {
  from {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  to {
    transform: translateY(34px) scale(0.985);
    opacity: 0;
  }
}

@keyframes cardInFromNext {
  from {
    transform: translateY(18px) scale(0.97);
    opacity: 0.82;
  }
  to {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}

@keyframes cardInFromPrev {
  from {
    transform: translateY(-18px) scale(0.97);
    opacity: 0.82;
  }
  to {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.tone-pill {
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(99, 102, 241, 0.12);
  color: #334155;
  font-size: 11px;
  font-weight: 800;
  max-width: 78%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.audio-btn {
  width: 34px;
  height: 34px;
  border-radius: 999px;
  background: rgba(99, 102, 241, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.audio-btn:active {
  transform: scale(0.98);
}

.audio-icon {
  width: 18px;
  height: 18px;
  opacity: 0.92;
}

.kr-wrap {
  margin-top: 14px;
}

.kr-text {
  font-size: 28px;
  font-weight: 900;
  color: #0f172a;
  white-space: pre-wrap;
  word-break: break-word;
  line-height: 1.22;
}

.romaji {
  margin-top: 6px;
  font-size: 12px;
  font-weight: 700;
  color: #64748b;
  display: block;
}

.card-body {
  margin-top: 14px;
  flex: 1;
  min-height: 0;
}

.desc {
  margin-bottom: 14px;
}

.desc-title {
  font-size: 12px;
  font-weight: 800;
  color: #64748b;
  display: block;
  margin-bottom: 6px;
}

.desc-text {
  font-size: 14px;
  color: #0f172a;
  line-height: 1.6;
  display: block;
}
