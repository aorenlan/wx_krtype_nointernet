.page {
  height: 100vh;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18% 6%, rgba(245, 170, 36, 0.16), transparent 28%),
    linear-gradient(180deg, #111217 0%, #f4f3ef 38%, #f8f8f6 100%);
  overflow: hidden;
  color: #202126;
}

.empty {
  height: calc(100vh - 120px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 24px;
  box-sizing: border-box;
  color: #64748b;
}

.empty-title {
  font-size: 18px;
  font-weight: 800;
  color: #ffffff;
}

.empty-sub {
  margin-top: 8px;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.62);
}

.list {
  height: 100%;
  padding: 16px 14px calc(26px + env(safe-area-inset-bottom, 0px));
  box-sizing: border-box;
}

.history-hero {
  min-height: 76px;
  margin: 2px 0 14px;
  padding: 12px 14px;
  border-radius: 24px;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.86), rgba(255, 255, 255, 0.62));
  border: 1px solid rgba(255, 255, 255, 0.76);
  box-shadow:
    0 24px 56px rgba(17, 18, 23, 0.14),
    inset 0 1px 0 rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  gap: 12px;
  box-sizing: border-box;
  backdrop-filter: blur(20px) saturate(1.06);
  -webkit-backdrop-filter: blur(20px) saturate(1.06);
}

.history-mark {
  width: 42px;
  height: 42px;
  border-radius: 999px;
  background: #17181d;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 900;
  box-shadow: 0 14px 30px rgba(17, 18, 23, 0.18);
  position: relative;
}

.history-mark::after {
  position: absolute;
  right: -2px;
  bottom: 3px;
  width: 10px;
  height: 10px;
  border: 2px solid rgba(255, 255, 255, 0.92);
  border-radius: 999px;
  background: #f5aa24;
  content: "";
}

.history-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.history-title {
  color: #202126;
  font-size: 18px;
  font-weight: 900;
  line-height: 1.15;
}

.history-sub {
  color: #7f847f;
  font-size: 12px;
  font-weight: 800;
  line-height: 1.25;
}

.item {
  min-height: 66px;
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.66);
  border-radius: 20px;
  padding: 12px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 10px;
  box-shadow:
    0 16px 38px rgba(17, 18, 23, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.82);
  box-sizing: border-box;
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.item:active {
  transform: scale(0.99);
}

.item-main {
  display: flex;
  flex-direction: column;
  gap: 5px;
  flex: 1;
  min-width: 0;
}

.item-dot {
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: #f5aa24;
  box-shadow: 0 0 0 5px rgba(245, 170, 36, 0.12);
  flex: 0 0 auto;
}

.item-source {
  font-size: 15px;
  font-weight: 800;
  color: #202126;
  line-height: 1.25;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.item-date {
  font-size: 12px;
  color: #7f847f;
  font-weight: 800;
}

.item-arrow {
  width: 24px;
  height: 24px;
  border-radius: 999px;
  background: rgba(23, 24, 29, 0.06);
  color: #8f9691;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 900;
  line-height: 1;
  flex: 0 0 auto;
}

.footer {
  padding: 12px 0 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.footer-text {
  font-size: 12px;
  color: #8f9691;
  font-weight: 700;
}
