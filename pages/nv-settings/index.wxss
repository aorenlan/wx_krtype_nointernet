.label {
  font-size: 14px;
  font-weight: 600;
  color: #334155;
  margin-bottom: 8px;
}

.sub-label {
  font-size: 12px;
  font-weight: 400;
  color: #94a3b8;
}

.input {
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 12px;
  font-size: 16px;
  color: #1e293b;
}

.textarea-wrap {
  flex: 1;
  position: relative;
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  overflow: hidden;
}

.textarea {
  width: 100%;
  height: 100%;
  padding: 12px;
  font-size: 16px;
  color: #1e293b;
  line-height: 1.6;
  box-sizing: border-box;
}

.fake-placeholder {
  position: absolute;
  top: 12px;
  left: 12px;
  pointer-events: none;
  opacity: 0.4;
}

.fake-placeholder-line {
  font-size: 16px;
  color: #94a3b8;
  line-height: 1.6;
}

.form-actions {
  margin-top: auto;
  padding-top: 16px;
}

.btn-primary-large {
  background: #3b82f6;
  color: white;
  border-radius: 12px;
  padding: 16px;
  font-size: 16px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.save-icon {
  margin-right: 8px;
}

/* Suggestion Box */
.suggestion-box {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-top: 1px solid #e2e8f0;
  box-shadow: 0 -4px 6px -1px rgba(0, 0, 0, 0.1);
  border-radius: 0 0 8px 8px;
  z-index: 100;
  max-height: 200px;
  overflow-y: auto;
}

.suggestion-header {
  padding: 8px 12px;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.suggestion-title {
  font-weight: 600;
  color: #3b82f6;
  font-size: 14px;
}

.suggestion-close {
  color: #94a3b8;
  font-size: 18px;
  padding: 0 4px;
}

.suggestion-list {
  padding: 0;
}

.suggestion-item {
  padding: 10px 12px;
  border-bottom: 1px solid #f1f5f9;
  display: flex;
  align-items: flex-start;
}

.suggestion-item:active {
  background: #f8fafc;
}

.suggestion-index {
  background: #eff6ff;
  color: #3b82f6;
  font-size: 11px;
  width: 18px;
  height: 18px;
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
  flex-shrink: 0;
  margin-top: 2px;
}

.suggestion-text {
  font-size: 14px;
  color: #334155;
  line-height: 1.4;
}

/* Smart Import Styles */
.smart-intro {
  font-size: 14px;
  color: #64748b;
  margin-bottom: 16px;
  line-height: 1.5;
}

.smart-textarea {
  width: 100%;
  height: 200px;
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 16px;
  font-size: 15px;
  color: #1e293b;
  box-sizing: border-box;
  margin-bottom: 24px;
}

.btn-smart-action {
  background: #eab308;
  color: white;
  border-radius: 12px;
  padding: 16px;
  font-size: 16px;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 4px 6px -1px rgba(234, 179, 8, 0.2);
}

.btn-smart-action:active {
  transform: scale(0.98);
}

.extend-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 11020;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 18px calc(22px + env(safe-area-inset-bottom));
  background: rgba(24, 25, 30, 0.22);
  backdrop-filter: blur(12px);
  box-sizing: border-box;
  animation: settings-mask-in 160ms ease-out both;
}

.extend-modal {
  position: relative;
  width: 100%;
  max-width: 720rpx;
  max-height: calc(82vh - env(safe-area-inset-bottom));
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.72);
  border-radius: 28px;
  background:
    radial-gradient(circle at 92% 0%, rgba(246, 179, 90, 0.1), transparent 34%),
    rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(22px);
  box-shadow:
    0 28px 70px rgba(24, 25, 30, 0.2),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
  animation: settings-card-in 180ms ease-out both;
}

.extend-modal-handle {
  width: 64px;
  height: 5px;
  border-radius: 999px;
  background: #d8dfda;
  margin: 10px auto 6px;
}

.extend-modal-body {
  max-height: calc(82vh - 22px - env(safe-area-inset-bottom));
  padding: 0 20px 24px;
  box-sizing: border-box;
}

.extend-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.extend-modal-title {
  color: #202126;
  font-size: 21px;
  font-weight: 900;
  line-height: 1.15;
}

.extend-modal-close {
  display: flex;
  width: 38px;
  height: 38px;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: #eff3f0;
  color: #526056;
  font-size: 22px;
  font-weight: 900;
  line-height: 1;
}

.extend-link-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
  padding: 12px;
  border: 1px solid rgba(24, 25, 30, 0.05);
  border-radius: 18px;
  background: rgba(248, 250, 248, 0.88);
}

.extend-help-card {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 14px;
  padding: 14px;
  border: 1px solid rgba(24, 25, 30, 0.05);
  border-radius: 20px;
  background:
    radial-gradient(circle at 96% 0%, rgba(245, 170, 36, 0.12), transparent 36%),
    rgba(248, 250, 248, 0.94);
  box-sizing: border-box;
}

.extend-help-title {
  color: #202126;
  font-size: 15px;
  font-weight: 900;
  line-height: 1.2;
}

.extend-help-desc {
  color: #6f7774;
  font-size: 12px;
  font-weight: 750;
  line-height: 1.5;
}

.extend-help-note {
  margin-top: 2px;
  color: #a06a12;
  font-size: 12px;
  font-weight: 850;
  line-height: 1.35;
}

.extend-link-copy {
  display: flex;
  min-width: 78px;
  height: 32px;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 999px;
  background: #17181d;
  color: #ffffff;
  font-size: 13px;
  font-weight: 900;
}

.extend-link-text {
  flex: 1;
  min-width: 0;
  color: #6f7774;
  font-size: 13px;
  font-weight: 700;
  word-break: break-all;
}

.extend-notice {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 14px;
  padding: 12px 14px;
  border: 1px solid rgba(246, 179, 90, 0.26);
  border-radius: 18px;
  background: rgba(255, 248, 234, 0.88);
}

.extend-notice-label {
  font-size: 12px;
  font-weight: 900;
  color: #c78215;
}

.extend-notice-text {
  font-size: 13px;
  font-weight: 800;
  line-height: 1.55;
  color: #6f7774;
  word-break: break-word;
}

.extend-input {
  width: 100%;
  height: 50px;
  margin-bottom: 14px;
  padding: 0 16px;
  border: 1px solid rgba(24, 25, 30, 0.05);
  border-radius: 18px;
  background: rgba(248, 250, 248, 0.9);
  box-sizing: border-box;
  font-size: 15px;
  font-weight: 800;
  color: #202126;
}

.ad-free-status-card {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-bottom: 14px;
  padding: 15px 16px 16px;
  border: 1px solid rgba(24, 25, 30, 0.05);
  border-radius: 22px;
  background:
    radial-gradient(circle at 96% 0%, rgba(245, 170, 36, 0.16), transparent 35%),
    #202126;
  color: #ffffff;
  box-shadow: 0 14px 30px rgba(24, 25, 30, 0.13);
  box-sizing: border-box;
}

.ad-free-status-card.is-idle {
  background:
    radial-gradient(circle at 96% 0%, rgba(245, 170, 36, 0.13), transparent 35%),
    #f5f7f4;
  color: #202126;
  box-shadow: 0 14px 30px rgba(24, 25, 30, 0.06);
}

.ad-free-status-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.ad-free-status-badge {
  flex: 0 0 auto;
  padding: 5px 9px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
  font-size: 10px;
  font-weight: 900;
  line-height: 1;
}

.ad-free-status-card.is-idle .ad-free-status-badge {
  background: #17181d;
  color: #ffffff;
}

.ad-free-status-plus {
  min-width: 0;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.72);
  font-size: 10px;
  font-weight: 800;
  line-height: 1.2;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ad-free-status-card.is-idle .ad-free-status-plus {
  color: #7d8580;
}

.ad-free-count-label {
  margin-top: 6px;
  color: rgba(255, 255, 255, 0.66);
  font-size: 12px;
  font-weight: 900;
  line-height: 1;
}

.ad-free-status-card.is-idle .ad-free-count-label {
  color: #7d8580;
}

.ad-free-countdown {
  color: #ffffff;
  font-size: 31px;
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: 0;
  word-break: break-all;
}

.ad-free-status-card.is-idle .ad-free-countdown {
  color: #202126;
}

.ad-free-expire {
  color: rgba(255, 255, 255, 0.72);
  font-size: 12px;
  font-weight: 900;
  line-height: 1.2;
}

.ad-free-status-card.is-idle .ad-free-expire {
  color: #7d8580;
}

.ad-free-section-label {
  margin: 12px 2px 7px;
  color: #8b8d96;
  font-size: 12px;
  font-weight: 900;
  line-height: 1;
}

.ad-free-redeem-row {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 50px;
  padding: 6px;
  border: 1px solid rgba(24, 25, 30, 0.05);
  border-radius: 20px;
  background: rgba(248, 250, 248, 0.9);
  box-sizing: border-box;
}

.ad-free-redeem-input {
  flex: 1;
  min-width: 0;
  height: 40px;
  padding: 0 10px;
  color: #202126;
  font-size: 15px;
  font-weight: 800;
  box-sizing: border-box;
}

.ad-free-redeem-btn {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 64px;
  height: 38px;
  padding: 0 13px;
  border-radius: 999px;
  background: #17181d;
  color: #ffffff;
  font-size: 13px;
  font-weight: 900;
  box-shadow: 0 10px 20px rgba(24, 25, 30, 0.14);
  box-sizing: border-box;
}

.ad-free-redeem-btn.is-loading {
  opacity: 0.72;
}

.ad-free-watch-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 72px;
  padding: 14px;
  border: 1px solid rgba(245, 170, 36, 0.25);
  border-radius: 22px;
  background:
    radial-gradient(circle at 96% 0%, rgba(245, 170, 36, 0.18), transparent 38%),
    #fff8ea;
  box-shadow: 0 12px 28px rgba(245, 170, 36, 0.1);
  box-sizing: border-box;
}

.ad-free-watch-card.is-loading {
  opacity: 0.74;
}

.ad-free-watch-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 5px;
}

.ad-free-watch-title {
  color: #202126;
  font-size: 16px;
  font-weight: 900;
  line-height: 1.2;
}

.ad-free-watch-desc {
  color: #7d6a3c;
  font-size: 12px;
  font-weight: 700;
  line-height: 1.38;
}

.ad-free-watch-pill {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 54px;
  height: 36px;
  padding: 0 12px;
  border-radius: 999px;
  background: #f5aa24;
  color: #17181d;
  font-size: 13px;
  font-weight: 900;
  box-shadow: 0 10px 20px rgba(245, 170, 36, 0.18);
  box-sizing: border-box;
}

.extend-submit-btn {
  width: 100%;
  height: 48px;
  line-height: 48px;
  border-radius: 999px;
  background: #17181d;
  color: #ffffff;
  font-size: 15px;
  font-weight: 950;
  box-shadow: 0 14px 30px rgba(24, 25, 30, 0.18);
}

.extend-submit-btn::after {
  border: none;
}

.extend-submit-btn[disabled] {
  opacity: 0.7;
  box-shadow: none;
}

.extend-ad-wrap {
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid #eef2f7;
  min-height: 96px;
  padding-bottom: 8px;
}
