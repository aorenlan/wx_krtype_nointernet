<custom-nav title="设置" theme="light" showSettings="{{false}}"></custom-nav>
<view style="padding-top: {{statusBarHeight + navBarHeight + 20}}px; height: 100vh; box-sizing: border-box;">
  <scroll-view
    class="container"
    scroll-y="true"
    enable-back-to-top="true"
    enable-flex="true"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    bounces="{{true}}"
    style="height: {{scrollHeight}}px;"
  >
  
  <!-- VIEW 1: CATEGORIES -->
  <block wx:if="{{view === 'categories'}}">
    <view class="page-title">词库设置</view>

    <view class="card action-card extend-entry-card" catchtap="openExtendModal">
      <view class="card-left">
        <view class="icon-circle orange">
          <text class="action-icon">＋</text>
        </view>
        <view class="extend-entry-texts">
          <text class="card-text">Web 学习工具</text>
        </view>
      </view>
      <view class="arrow-icon">›</view>
    </view>

    <!-- 免广告入口 -->
    <view class="card action-card" catchtap="openRedeemModal" style="margin-top: 12px;">
      <view class="card-left">
        <view class="icon-circle green">
          <text class="action-icon ad-icon">AD</text>
        </view>
        <view class="extend-entry-texts">
          <text class="card-text">免广告</text>
          <text class="extend-entry-desc" wx:if="{{adFreeActive}}">剩余 {{adFreeRemainText}}</text>
          <text class="extend-entry-desc" wx:else>兑换码或看广告免一天</text>
        </view>
      </view>
      <view class="arrow-icon">›</view>
    </view>

    <!-- 联系开发者入口 -->
    <view class="card action-card" bindtap="onContactSupport" style="margin-top: 12px;">
      <view class="card-left">
        <view class="icon-circle blue">
          <text class="action-icon">💬</text>
        </view>
        <text class="card-text">联系开发者</text>
      </view>
      <view class="arrow-icon">›</view>
    </view>

    <!-- 趣味韩语入口 -->
    <view class="card action-card" bindtap="goToHiChat" style="margin-top: 12px;">
      <view class="card-left">
        <view class="icon-circle purple">
          <text class="action-icon">🎮</text>
        </view>
        <text class="card-text">趣味韩语</text>
      </view>
      <view class="arrow-icon">›</view>
    </view>

    <!-- 词库设置 -->
    <view class="section-title" style="margin-top: 24px;">词库设置</view>

    <!-- Word Book List -->
    <view class="book-list">
      <block wx:for="{{categories}}" wx:key="*this">
        <view class="card book-card {{currentCategory === item ? 'active' : ''}}" bindtap="selectCategory" data-category="{{item}}">
            <view class="active-bar" wx:if="{{currentCategory === item}}"></view>
            <view class="book-content">
                <view class="book-info">
                    <text class="book-name {{currentCategory === item ? 'active-text' : ''}}">{{item}}</text>
                    
                    <!-- Mistakes Logic -->
                    <text class="book-desc" wx:if="{{item === 'Mistakes (错题本)'}}">{{mistakesCount}} 个单词</text>
                    
                    <!-- Standard Logic -->
                    <view class="book-desc-row" wx:else>
                       <text class="icon-headphones">🎧</text> 
                       <text>{{categoryCounts[item] || 0}} 个单词</text>
                       <text wx:if="{{currentCategory !== item}}" style="margin-left: 8px;">点击进入设置</text>
                    </view>
                </view>
                <view class="arrow-icon">›</view>
            </view>
        </view>
        
        <!-- Activity Card for TOPIK Vocabulary -->
        <!-- <view wx:if="{{item === 'TOPIK Vocabulary'}}" class="card book-card activity-card" bindtap="navigateToCounterAttack" style="margin-top: 12px; border: 2px solid #e0e7ff; background: #f5f7ff;">
             <view class="book-content">
                <view class="book-info">
                    <text class="book-name" style="color: #4f46e5; font-weight: 700;">🚀 活动: 反击词汇 (Counter-Attack)</text>
                    <view class="book-desc-row">
                       <text style="color: #6366f1;">掌握关键时刻的有力表达 🔥</text>
                    </view>
                </view>
                <view class="arrow-icon" style="color: #4f46e5;">›</view>
             </view>
        </view> -->
      </block>
    </view>

    <view class="action-cards">
      <view class="card action-card" bindtap="switchVersion">
        <view class="card-left">
          <view class="icon-circle gray">
            <text class="action-icon">↺</text>
          </view>
          <text class="card-text">切换回旧版本</text>
        </view>
        <view class="arrow-icon">›</view>
      </view>
    </view>

  </block>
  <!-- VIEW 2: SETTINGS -->
  <block wx:if="{{view === 'filters'}}">
    <view class="header-bar">
      <view class="back-btn" bindtap="goBackToCategories">
        <text class="icon">‹</text>
        <text>返回词书列表</text>
      </view>
      <view class="category-header">
        <text class="category-title">{{currentCategory}}</text>
        <text class="category-count">共 {{totalWords}} 个单词</text>
      </view>
    </view>

    <view class="filter-content">
      <!-- Removed Word Book Picker as per request -->
      <!-- <view class="setting-section">
        <view class="section-title">词书</view>
        <picker mode="selector" range="{{categories}}" value="{{categoryPickerIndex}}" bindchange="onCategoryPickerChange">
          <view class="category-item picker-item">
            <text class="picker-label">选择词书</text>
            <view class="picker-right">
              <text class="picker-value">{{settings.category}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </view>
        </picker>
      </view> -->

      <view class="setting-section" wx:if="{{showTopikSub}}">
        <view class="section-title">选择二级分类</view>
        <picker mode="selector" range="{{topikLevels}}" value="{{topikLevelPickerIndex}}" bindchange="onTopikLevelPickerChange">
          <view class="category-item picker-item">
            <text class="picker-label">TOPIK 等级</text>
            <view class="picker-right">
              <text class="picker-value">TOPIK {{settings.topikLevel}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </view>
        </picker>

        <view class="topik-session" wx:if="{{topikSessions.length}}">
          <text class="picker-label">Session</text>
          <scroll-view scroll-x class="topik-session-scroll" show-scrollbar="{{false}}">
            <view class="topik-session-row">
              <block wx:for="{{topikSessions}}" wx:key="*this">
                <view class="topik-session-chip {{settings.topikSession === item ? 'active' : ''}}" bindtap="selectTopikSession" data-session="{{item}}">
                  <text>{{item}}</text>
                </view>
              </block>
            </view>
          </scroll-view>
        </view>
      </view>

      <view class="setting-section" wx:if="{{showYonseiSub}}">
        <view class="section-title">选择二级分类</view>
        <picker mode="selector" range="{{yonseiLessonOptions}}" value="{{yonseiLessonPickerIndex}}" bindchange="onYonseiLessonPickerChange">
          <view class="category-item picker-item">
            <text class="picker-label">课次 </text>
            <view class="picker-right">
              <text class="picker-value">{{yonseiLessonDisplay}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </view>
        </picker>
      </view>

      <view class="setting-section" wx:if="{{currentCategory === photoRecognitionCategory}}">
        <view class="section-title">拍照练习</view>
        <view class="photo-manage-card">
          <view class="photo-manage-copy">
            <text class="photo-manage-title">已保存 {{photoRecognitionCount}} 个单词</text>
            <text class="photo-manage-desc">从拍照历史加入，最新加入会排在前面。</text>
          </view>
          <view class="photo-manage-btn" bindtap="clearPhotoRecognitionWords">清空</view>
        </view>
        <view class="photo-word-heading" wx:if="{{photoRecognitionWords.length}}">
          <text>单词列表</text>
          <text>{{photoRecognitionWords.length}} 个</text>
        </view>
        <view class="photo-word-list" wx:if="{{photoRecognitionWords.length}}">
          <view wx:for="{{photoRecognitionWords}}" wx:key="id" class="photo-word-row">
            <view class="photo-word-copy">
              <text class="photo-word-ko">{{item.word}}</text>
              <text class="photo-word-meaning">{{item.meaning || '暂无释义'}}</text>
            </view>
            <view class="photo-word-delete" data-id="{{item.id}}" catchtap="removePhotoRecognitionWord">删除</view>
          </view>
        </view>
      </view>

      <view class="setting-section" wx:if="{{currentCategory === pictureWordsPracticeCategory}}">
        <view class="section-title">看图学韩语</view>
        <view class="photo-manage-card">
          <view class="photo-manage-copy">
            <text class="photo-manage-title">已保存 {{pictureWordsPracticeCount}} 个单词</text>
            <text class="photo-manage-desc">从看图分类加入，最新加入会排在前面。</text>
          </view>
          <view class="photo-manage-btn" bindtap="clearPictureWordsPracticeWords">清空</view>
        </view>
        <view class="photo-word-heading" wx:if="{{pictureWordsPracticeWords.length}}">
          <text>单词列表</text>
          <text>{{pictureWordsPracticeWords.length}} 个</text>
        </view>
        <view class="photo-word-list" wx:if="{{pictureWordsPracticeWords.length}}">
          <view wx:for="{{pictureWordsPracticeWords}}" wx:key="id" class="photo-word-row">
            <view class="photo-word-copy">
              <text class="photo-word-ko">{{item.word}}</text>
              <text class="photo-word-meaning">{{item.meaning || '暂无释义'}}</text>
            </view>
            <view class="photo-word-delete" data-id="{{item.id}}" catchtap="removePictureWordsPracticeWord">删除</view>
          </view>
        </view>
      </view>

      <view class="setting-section" wx:if="{{currentCategory === 'Mistakes (错题本)'}}">
        <view class="section-title">错题管理</view>
        <view class="photo-manage-card mistake-manage-card">
          <view class="photo-manage-copy">
            <text class="photo-manage-title">已保存 {{mistakesCount}} 个单词</text>
            <text class="photo-manage-desc">从练习中加入，最新错题会排在前面。</text>
          </view>
          <view class="photo-manage-btn" bindtap="startMistakesPractice">去练习</view>
        </view>
        <view class="photo-word-heading" wx:if="{{mistakesList.length}}">
          <text>错题列表</text>
          <text>{{mistakesList.length}} 个</text>
        </view>
        <view class="photo-word-list" wx:if="{{mistakesList.length}}">
          <view wx:for="{{mistakesList}}" wx:key="id" class="photo-word-row mistake-word-row">
            <view class="photo-word-copy">
              <text class="photo-word-ko">{{item.word || item.korean || item.kr || '未命名单词'}}</text>
              <text class="photo-word-meaning">{{item.meaning || item.cn || item.translation || item.chinese || '暂无释义'}}</text>
            </view>
            <view class="photo-word-delete" data-id="{{item.id}}" data-word="{{item.word || item.korean || item.kr}}" catchtap="removeMistake">移除</view>
          </view>
        </view>
        <view class="mistake-empty-card" wx:else>
          <text>暂无错题</text>
        </view>
      </view>
    </view>
  </block>

  <!-- VIEW 3: IMPORT LIST -->
  <block wx:if="{{view === 'importList'}}">
    <view class="nav-header" bindtap="goBackToCategories">
      <text class="back-arrow">‹</text>
      <text class="back-text">返回设置</text>
    </view>
    
    <view class="page-title-large">
      <text>导入单词</text>
      <text class="page-count">{{lists.length}}/10</text>
    </view>

    <!-- Top Action Cards -->
    <view class="top-cards-grid">
      <!-- Manual Input -->
      <view class="action-card-column" bindtap="createNewList">
        <view class="icon-circle-large blue-bg">
          <text class="plus-icon-large">+</text>
        </view>
        <text class="action-text">手动输入</text>
      </view>

      <!-- Smart Import -->
      <view class="action-card-column" bindtap="onSmartImport">
        <view class="icon-circle-large yellow-bg">
          <text class="lightning-icon">⚡️</text>
        </view>
        <view class="text-group">
            <text class="action-text">自动导入</text>
            <text class="action-subtext">自动识别文本</text>
        </view>
      </view>

      <view class="action-card-column" bindtap="onCameraClick">
        <view class="icon-circle-large gray-bg">
          <text class="camera-icon">📷</text>
        </view>
        <view class="text-group">
            <text class="action-text">拍照导入</text>
            <text class="action-subtext">仅支持语境官网</text>
        </view>
      </view>
    </view>

    <view class="section-label">我的词单</view>

    <view class="list-container">
      <block wx:for="{{lists}}" wx:key="id">
        <view class="card list-item {{item.isFavorites ? 'favorites-item' : ''}}">
          <view class="item-info">
            <text class="item-name">{{item.isFavorites ? '⭐ ' : ''}}{{item.name}}</text>
            <text class="item-meta">{{item.words.length}} 个单词 • {{item.formattedDate}}</text>
          </view>
          <view class="item-actions">
            <view class="action-icon" catchtap="editList" data-id="{{item.id}}">✎</view>
            <view class="action-icon" catchtap="exportList" data-id="{{item.id}}">📥</view>
            <view class="action-icon delete" catchtap="deleteList" data-id="{{item.id}}">🗑️</view>
          </view>
        </view>
      </block>

      <view class="empty-state" wx:if="{{lists.length === 0}}">
         <text class="empty-text">暂无词单，点击上方“手动输入”添加</text>
      </view>
    </view>
  </block>

  <!-- VIEW 4: IMPORT FORM -->
  <block wx:if="{{view === 'importForm'}}">
    <view class="nav-header" bindtap="goBackToImportList">
      <text class="back-arrow">‹</text>
      <text class="back-text">返回列表</text>
    </view>

    <view class="page-title-large">
      <text>{{editingId ? '编辑词单' : '新建词单'}}</text>
    </view>

    <view class="form-content">
      <view class="form-group">
        <text class="label">名称</text>
        <input class="input" placeholder="例如：我的生词本" value="{{name}}" bindinput="onNameInput" />
      </view>

      <view class="form-group flex-1">
        <text class="label">单词内容 <text class="sub-label">(每行一个，格式：单词 [可选释义])</text></text>
        <view class="textarea-wrap">
          <view class="fake-placeholder" wx:if="{{!content}}">
            <block wx:for="{{importPlaceholderLines}}" wx:key="*this">
              <view class="fake-placeholder-line">
                <text>{{item}}</text>
              </view>
            </block>
          </view>
          <textarea 
            class="textarea" 
            placeholder="" 
            value="{{content}}" 
            bindinput="onContentInput" 
            cursor="{{contentCursor}}"
            focus="{{contentFocus}}"
            maxlength="-1"
          ></textarea>
        </view>
        
        <!-- Suggestion Box -->
        <view class="suggestion-box" wx:if="{{suggestion}}">
            <view class="suggestion-header">
                <text class="suggestion-title">{{suggestion.word}}</text>
                <view class="suggestion-close" bindtap="closeSuggestion">×</view>
            </view>
            <view class="suggestion-list">
                <block wx:for="{{suggestion.meanings}}" wx:key="*this">
                    <view class="suggestion-item" bindtap="confirmSuggestion" data-meaning="{{item}}">
                        <text class="suggestion-index">{{index + 1}}</text>
                        <text class="suggestion-text">{{item}}</text>
                    </view>
                </block>
            </view>
        </view>
      </view>

      <view class="form-actions">
        <button class="btn-primary-large" bindtap="saveList">
          <text class="save-icon">💾</text> 保存
        </button>
      </view>
    </view>
  </block>

  <!-- VIEW 5: SMART IMPORT -->
  <block wx:if="{{view === 'smartImport'}}">
    <view class="nav-header" bindtap="goBackToImportList">
      <text class="back-arrow">‹</text>
      <text class="back-text">返回列表</text>
    </view>

    <view class="page-title-large">
      <text>自动导入</text>
    </view>

    <view class="smart-intro">
      粘贴任意包含英文的文本，将自动提取单词并匹配释义。
    </view>

    <textarea 
        class="smart-textarea" 
        placeholder="在这里粘贴英文文章、字幕、笔记..." 
        value="{{content}}" 
        bindinput="onContentInput" 
        maxlength="-1"
    ></textarea>

    <view class="btn-smart-action" bindtap="startSmartRecognition">
        <text>开始识别</text>
    </view>
  </block>

  </scroll-view>

  <view class="settings-confirm-mask" wx:if="{{showPhotoClearConfirm}}" bindtap="closePhotoClearConfirm" catchtouchmove="preventBubble">
    <view class="settings-confirm-card" catchtap="preventBubble">
      <view class="settings-confirm-mark">
        <view class="settings-confirm-dot"></view>
      </view>
      <text class="settings-confirm-title">清空拍照练习</text>
      <text class="settings-confirm-copy">会删除 {{photoRecognitionCount}} 个练习单词，拍照历史记录仍会保留。</text>
      <view class="settings-confirm-actions">
        <view class="settings-confirm-btn secondary" catchtap="closePhotoClearConfirm">取消</view>
        <view class="settings-confirm-btn primary" catchtap="confirmClearPhotoRecognitionWords">清空</view>
      </view>
    </view>
  </view>

  <view class="settings-confirm-mask" wx:if="{{showPictureWordsClearConfirm}}" bindtap="closePictureWordsClearConfirm" catchtouchmove="preventBubble">
    <view class="settings-confirm-card" catchtap="preventBubble">
      <view class="settings-confirm-mark">
        <view class="settings-confirm-dot"></view>
      </view>
      <text class="settings-confirm-title">清空看图学韩语</text>
      <text class="settings-confirm-copy">会删除 {{pictureWordsPracticeCount}} 个练习单词，看图分类原数据不会受影响。</text>
      <view class="settings-confirm-actions">
        <view class="settings-confirm-btn secondary" catchtap="closePictureWordsClearConfirm">取消</view>
        <view class="settings-confirm-btn primary" catchtap="confirmClearPictureWordsPracticeWords">清空</view>
      </view>
    </view>
  </view>

  <view class="settings-confirm-mask" wx:if="{{showDeleteListConfirm}}" bindtap="closeDeleteListConfirm" catchtouchmove="preventBubble">
    <view class="settings-confirm-card" catchtap="preventBubble">
      <view class="settings-confirm-mark danger">
        <view class="settings-confirm-dot"></view>
      </view>
      <text class="settings-confirm-title">删除词单</text>
      <text class="settings-confirm-copy">“{{pendingDeleteListName}}” 删除后不可恢复，已保存的其他词单不会受影响。</text>
      <view class="settings-confirm-actions">
        <view class="settings-confirm-btn secondary" catchtap="closeDeleteListConfirm">取消</view>
        <view class="settings-confirm-btn danger" catchtap="confirmDeleteList">删除</view>
      </view>
    </view>
  </view>

  <view class="settings-confirm-mask" wx:if="{{showSettingsGeneralConfirm}}" bindtap="closeSettingsGeneralConfirm" catchtouchmove="preventBubble">
    <view class="settings-confirm-card" catchtap="preventBubble">
      <view class="settings-confirm-mark {{settingsGeneralDanger ? 'danger' : ''}}">
        <view class="settings-confirm-dot"></view>
      </view>
      <text class="settings-confirm-title">{{settingsGeneralTitle}}</text>
      <text class="settings-confirm-copy">{{settingsGeneralCopy}}</text>
      <view class="settings-confirm-actions">
        <view class="settings-confirm-btn secondary" catchtap="closeSettingsGeneralConfirm">取消</view>
        <view class="settings-confirm-btn {{settingsGeneralDanger ? 'danger' : 'primary'}}" catchtap="confirmSettingsGeneral">{{settingsGeneralPrimaryText}}</view>
      </view>
    </view>
  </view>

  <!-- 免广告弹窗 -->
  <view class="extend-modal-mask" wx:if="{{showRedeemModal}}" bindtap="closeRedeemModal">
    <view class="extend-modal" catchtap="preventBubble">
      <view class="extend-modal-handle"></view>
      <scroll-view scroll-y class="extend-modal-body" show-scrollbar="{{false}}">
        <view class="extend-modal-header">
          <text class="extend-modal-title">免广告</text>
          <text class="extend-modal-close" bindtap="closeRedeemModal">×</text>
        </view>

        <view class="ad-free-status-card {{adFreeActive ? 'is-active' : 'is-idle'}}">
          <view class="ad-free-status-top">
            <text class="ad-free-status-badge">{{adFreeActive ? '生效中' : '未开启'}}</text>
            <text class="ad-free-status-plus">每次完整观看 +24 小时</text>
          </view>
          <text class="ad-free-count-label">剩余免广告</text>
          <text class="ad-free-countdown">{{adFreeRemainText}}</text>
          <text class="ad-free-expire">{{adFreeExpireText}}</text>
        </view>

        <view class="extend-notice" wx:if="{{redeemNotice}}">
          <text class="extend-notice-label">公告</text>
          <text class="extend-notice-text">{{redeemNotice}}</text>
        </view>

        <view class="ad-free-section-label">兑换码</view>
        <view class="ad-free-redeem-row">
          <input
            class="ad-free-redeem-input"
            placeholder="输入免广告码"
            value="{{redeemCode}}"
            confirm-type="done"
            bindconfirm="submitRedeemCode"
            bindinput="onRedeemCodeInput"
          />
          <view class="ad-free-redeem-btn {{redeemSubmitting ? 'is-loading' : ''}}" bindtap="submitRedeemCode">
            {{redeemSubmitting ? '验证中' : '兑换'}}
          </view>
        </view>

        <view class="ad-free-section-label">看广告续时长</view>
        <view class="ad-free-watch-card {{adFreeRewardSubmitting ? 'is-loading' : ''}}" bindtap="watchAdFreeOneDay">
          <view class="ad-free-watch-copy">
            <text class="ad-free-watch-title">看广告 +24 小时</text>
            <text class="ad-free-watch-desc">完整观看一次，就在当前倒计时后继续追加。</text>
          </view>
          <view class="ad-free-watch-pill">{{adFreeRewardSubmitting ? '加载中' : '+24h'}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="extend-modal-mask" wx:if="{{showExtendModal}}" bindtap="closeExtendModal">
    <view class="extend-modal" catchtap="preventBubble">
      <view class="extend-modal-handle"></view>
      <scroll-view scroll-y class="extend-modal-body" show-scrollbar="{{false}}">
        <view class="extend-modal-header">
          <text class="extend-modal-title">Web 学习工具</text>
          <text class="extend-modal-close" bindtap="closeExtendModal">×</text>
        </view>

        <view class="extend-help-card">
          <text class="extend-help-title">复制链接到浏览器打开</text>
          <text class="extend-help-desc">这是网页版学习工具。打开后复制网页里的 id，回到这里填写，看完广告后给网页工具增加 3 天使用时长。</text>
          <text class="extend-help-note">功能持续迭代中，后续会继续补充更多练习能力。</text>
        </view>

        <view class="extend-link-row">
          <view class="extend-link-copy" bindtap="copyExtendLink">复制链接</view>
          <text class="extend-link-text">{{extendLink}}</text>
        </view>

        <view class="extend-notice" wx:if="{{extendNotice}}">
          <text class="extend-notice-label">公告</text>
          <text class="extend-notice-text">{{extendNotice}}</text>
        </view>

        <input
          class="extend-input"
          placeholder="请输入网页工具里的 id"
          value="{{extendUserId}}"
          bindinput="onExtendUserIdInput"
        />

        <button
          class="extend-submit-btn"
          bindtap="submitExtendDay"
          loading="{{extendSubmitting}}"
          disabled="{{extendSubmitting}}"
        >
          看广告给 Web 工具加 3 天
        </button>

        <view class="extend-ad-wrap" wx:if="{{!adFreeActive}}">
          <ad-custom
            unit-id="adunit-f4c44c67aaa282e0"
            bindload="adLoad"
            binderror="adError"
            bindclose="adClose"
          ></ad-custom>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
