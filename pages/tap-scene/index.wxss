}

.tap-page.landscape .tap-landscape-main {
  flex: 1 1 0;
  min-height: 0;
  width: 100%;
  height: calc(100vh - 56px);
  height: calc(100vh - 56px - constant(safe-area-inset-bottom));
  height: calc(100vh - 56px - env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(230px, 280px);
  align-items: stretch;
  gap: 12px;
  overflow: hidden;
  box-sizing: border-box;
}

.tap-page.landscape .tap-scroll {
  position: relative;
  width: 100%;
  height: calc(100vh - 56px) !important;
  height: calc(100vh - 56px - constant(safe-area-inset-bottom)) !important;
  height: calc(100vh - 56px - env(safe-area-inset-bottom)) !important;
  overflow: hidden;
  box-sizing: border-box;
}

.tap-page.landscape .tap-content {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  gap: 8px;
  align-items: stretch;
  overflow: hidden;
  box-sizing: border-box;
}

.tap-page.landscape .scene-card {
  min-height: 0;
